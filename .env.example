# Copy to .env.local for local development (do not commit .env.local).
# Public browser credentials only. Use one Supabase project's URL and anon or
# publishable key together; RLS protects data, not secrecy of these values.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Never add a service_role key, sb_secret_* key, database password, or SMTP key.
# Astro embeds PUBLIC_* values into the static bundle at BUILD time.
