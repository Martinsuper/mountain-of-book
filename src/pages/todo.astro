<script>
import { initCalendarSubscription } from '../lib/calendar-subscription';
import {
  TODO_IMPORT_FLAG_KEY, TODO_SKIP_IMPORT_KEY, TODO_STORAGE_VERSION,
  cloneTodoItems, diffTodoItems, isUuid, newTodoId, readLocalTodos, remoteTodoSync,
  todoItemToInsertRow, writeLocalTodos,
  type TodoItem, type TodoStorage,
} from '../lib/todo-store';
import { supabase, configurationMessage } from '../lib/supabase';

let subscription: ReturnType<typeof initCalendarSubscription> | undefined;

// ============ 存储层：账号云端（Supabase user_todos）+ 本地镜像 ============
// 登录验证通过后才加载待办；游客、未配置及验证失败时关闭界面，禁止本地模式绕过。
// 数据模型与行转换见 src/lib/todo-store.ts。
type Backend = 'local' | 'remote';
type SyncStatusKind = 'unconfigured' | 'loading' | 'signed-out' | 'idle' | 'syncing' | 'error' | 'offline';
let backend: Backend = 'local';
let userId: string | null = null;
let state: TodoStorage = { items: [], version: TODO_STORAGE_VERSION, lastUpdated: Date.now() };
let authGeneration = 0;
const privatePanel = document.getElementById('todo-private')!;
const authStatus = document.getElementById('todo-auth-status')!;
/** Revoke access immediately, including dialogs and stale asynchronous loads. */
function lockTodoPage(message = '请先登录账号后使用待办。'): void {
  authGeneration++; userId = null; privatePanel.hidden = true; privatePanel.inert = true;
  authStatus.hidden = false; authStatus.textContent = message;
  if (retryTimer) { clearTimeout(retryTimer); retryTimer = null; }
  state = { items: [], version: TODO_STORAGE_VERSION, lastUpdated: Date.now() }; confirmedServer = []; importCandidate = [];
  privatePanel.querySelectorAll('.modal-overlay.show,.batch-actions-panel.show,.undo-toast.show').forEach(el => el.classList.remove('show'));
  privatePanel.querySelectorAll('.task-list,#archiveList,#calGrid,#calUnscheduled,#calendarDayEvents').forEach(el => el.replaceChildren());
  privatePanel.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input,textarea').forEach(el => el.value = '');
}
/** Reveal controls only after the account has been verified. */
function unlockTodoPage(): void { privatePanel.hidden = false; privatePanel.inert = false; authStatus.hidden = true; }
let confirmedServer: TodoItem[] = []; // 服务端已确认的条目快照，同步差异以它为基准
let syncing = false;
let retryTimer: number | null = null;
let refreshBusy = false;
// 切换到云端模式前捕获的本地数据快照，供「云端为空时导入本地历史」使用；
// 不能直接读镜像，因为云端加载完成后镜像会被云端数据覆盖。
let importCandidate: TodoItem[] = [];

function getStorage(): TodoStorage { return state; }

function saveStorage(): void {
  if (!userId || privatePanel.hidden) return;
  writeLocalTodos(state);
  if (backend === 'remote') void pumpRemoteSync();
}

function setSyncStatus(kind: SyncStatusKind): void {
  const el = document.getElementById('syncStatus');
  if (!el) return;
  switch (kind) {
    case 'unconfigured': el.replaceChildren(); break;
    case 'loading': el.textContent = '正在加载账号待办…'; break;
    case 'signed-out': {
      const link = document.createElement('a');
      link.href = '/account/';
      link.textContent = '登录账号';
      el.replaceChildren(document.createTextNode('待办数据目前仅保存在此浏览器，'), link, document.createTextNode('后可云端同步。'));
      break;
    }
    case 'idle': el.textContent = '已同步到账号云端'; break;
    case 'syncing': el.textContent = '正在同步云端数据…'; break;
    case 'error': el.textContent = '云端同步失败，15 秒后自动重试；期间修改仍保存在本浏览器。'; break;
    case 'offline': el.textContent = '云端暂时不可用，当前显示和保存的是本地缓存。'; break;
  }
}

// 云端写入泵：以「服务端已确认快照 → 当前状态」的内容差异驱动，
// 发送后重算差异，失败保留基准 15 秒后自动重试，快速连续编辑也只会推送最终结果。
async function pumpRemoteSync(): Promise<void> {
  if (!remoteTodoSync || !userId || syncing) return;
  const generation = authGeneration;
  const uid = userId;
  syncing = true;
  try {
    while (true) {
      if (generation !== authGeneration || uid !== userId) return;
      const target = cloneTodoItems(state.items);
      const diff = diffTodoItems(confirmedServer, target);
      if (!diff.inserts.length && !diff.updates.length && !diff.deletes.length) { setSyncStatus('idle'); return; }
      setSyncStatus('syncing');
      try {
        await remoteTodoSync.push(uid, diff);
        if (generation !== authGeneration) return;
        confirmedServer = target;
      } catch {
        if (generation !== authGeneration) return;
        setSyncStatus('error');
        if (retryTimer) clearTimeout(retryTimer);
        retryTimer = window.setTimeout(() => { retryTimer = null; void pumpRemoteSync(); }, 15_000);
        return;
      }
    }
  } finally { syncing = false; }
}

// 启动：确认登录态后选择本地 / 云端模式并加载/重绘
async function initStorage(): Promise<void> {
  const current = ++authGeneration;
  if (!supabase) { lockTodoPage(configurationMessage); return; }
  setSyncStatus('loading');
  try {
    const { data: { user }, error } = await supabase.auth.getUser();
    if (current !== authGeneration) return;
    if (error || !user) { lockTodoPage(); window.location.replace('/account/'); return; }
    userId = user.id;
    state = readLocalTodos();
    const localSnapshot = backend === 'local' ? cloneTodoItems(state.items) : [];
    const remote = await remoteTodoSync!.fetch(userId);
    if (current !== authGeneration) return;
    unlockTodoPage();
    if (!subscription) subscription = initCalendarSubscription(() => { if (userId) { renderCalendar(searchInput.value); subscription?.refreshDetails(); } });
    if (!remote) { backend = 'local'; state = { items: [], version: TODO_STORAGE_VERSION, lastUpdated: Date.now() }; setSyncStatus('offline'); renderTasks(searchInput.value); return; }
    backend = 'remote';
    confirmedServer = cloneTodoItems(remote);
    state = { items: cloneTodoItems(remote), version: TODO_STORAGE_VERSION, lastUpdated: Date.now() };
    writeLocalTodos(state);
    importCandidate = remote.length ? [] : localSnapshot.filter(item => item.title.trim());
    setSyncStatus('idle');
    renderTasks(searchInput.value);
    offerLocalImport();
  } catch {
    if (current !== authGeneration) return;
    lockTodoPage('登录验证或待办加载失败，请刷新重试。');
  }
}

// 云端为空且切换前有本地历史数据时，提供一次性导入入口
function offerLocalImport(): void {
  const banner = document.getElementById('importBanner');
  if (!banner || !userId) return;
  if (localStorage.getItem(TODO_IMPORT_FLAG_KEY) || sessionStorage.getItem(TODO_SKIP_IMPORT_KEY)) return;
  if (!importCandidate.length || state.items.length) { importCandidate = []; return; }
  document.getElementById('importText')!.textContent = `检测到此浏览器保存的 ${importCandidate.length} 条待办尚未同步，可一键导入到账号。`;
  banner.hidden = false;
}

async function importLocalTodos(): Promise<void> {
  const banner = document.getElementById('importBanner');
  if (!supabase || !userId || backend !== 'remote' || !importCandidate.length) return;
  const uid = userId; // 守卫后捕获具体类型，消除回调中的可空性
  const items = importCandidate.map(item => ({ ...item, id: isUuid(item.id) ? item.id : newTodoId() }));
  if (!items.length) return;
  const confirmBtn = document.getElementById('importConfirmBtn') as HTMLButtonElement;
  confirmBtn.disabled = true;
  try {
    const { error } = await supabase.from('user_todos').insert(items.map(item => todoItemToInsertRow(item, uid)));
    if (error) throw error;
    localStorage.setItem(TODO_IMPORT_FLAG_KEY, '1');
    state = { items, version: TODO_STORAGE_VERSION, lastUpdated: Date.now() };
    confirmedServer = cloneTodoItems(items);
    writeLocalTodos(state);
    if (banner) banner.hidden = true;
    setSyncStatus('idle');
    renderTasks(searchInput.value);
  } catch {
    document.getElementById('importText')!.textContent = '导入失败，请检查网络后重试。';
  } finally { confirmBtn.disabled = false; }
}

// 其他标签页登录 / 登出时跟随切换模式
supabase?.auth.onAuthStateChange(event => {
  if (event === 'SIGNED_OUT') { lockTodoPage(); window.location.replace('/account/'); return; }
  if (event !== 'SIGNED_IN' && event !== 'SIGNED_OUT') return;
  void refreshAccountState();
});

async function refreshAccountState(): Promise<void> {
  if (refreshBusy) return;
  refreshBusy = true;
  try { await initStorage(); if (userId) renderTasks(searchInput.value); }
  finally { refreshBusy = false; }
}

function formatDate(timestamp: number): string {
  const date = new Date(timestamp);
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
}

function formatDateTime(timestamp: number): string {
  return new Date(timestamp).toLocaleString('zh-CN', {
    year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
  });
}

// 给 date 输入框用的本地日期格式：YYYY-MM-DD
function formatDateInput(timestamp: number): string {
  return formatDate(timestamp);
}

// 日期截止按当天结束处理，避免当天任务在 00:00 就显示逾期
function dateToDeadline(value: string): number | undefined {
  if (!value) return undefined;
  const [year, month, day] = value.split('-').map(Number);
  return new Date(year, month - 1, day, 23, 59, 59, 999).getTime();
}

function isDueSoon(dueDate?: number): boolean {
  if (!dueDate) return false;
  const today = new Date();
  const tomorrowStart = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 1).getTime();
  return dueDate >= today.getTime() && dueDate < tomorrowStart;
}

function isOverdue(dueDate?: number): boolean {
  if (!dueDate) return false;
  const todayStart = new Date();
  todayStart.setHours(0, 0, 0, 0);
  return dueDate < todayStart.getTime();
}

function getQuadrantColor(q: number): string {
  const colors: Record<number, string> = {
    1: '#ef4444',
    2: '#3b82f6',
    3: '#f59e0b',
    4: '#6b7280'
  };
  return colors[q] || '#6b7280';
}

function getPriorityOrder(p: string): number {
  const orders: Record<string, number> = { high: 3, medium: 2, low: 1 };
  return orders[p] || 0;
}

// 设置日期输入的最小值（今天）
function setDateMinToday() {
  const today = formatDate(Date.now());
  taskDue.min = today;
  editTaskDue.min = today;
}

// 清空添加表单
function clearAddForm() {
  taskTitle.value = '';
  taskDesc.value = '';
  taskDue.value = formatDateInput(Date.now());
  (document.getElementById('taskCategory') as HTMLInputElement).value = '';
  currentQuadrant = 1;
  currentPriority = 'medium';
  updateQuadrantBtns(quadrantBtns, currentQuadrant);
  updatePriorityBtns(priorityBtns, currentPriority);
}

document.getElementById('categoryFilter')?.addEventListener('change', () => renderTasks());

// DOM 元素
const searchInput = document.getElementById('searchInput') as HTMLInputElement;
const searchClearBtn = document.getElementById('searchClearBtn');
const addTaskBtn = document.getElementById('addTaskBtn');
const batchModeBtn = document.getElementById('batchModeBtn');
const clearCompletedBtn = document.getElementById('clearCompletedBtn');
const batchActionsPanel = document.getElementById('batchActionsPanel');
const selectedCountEl = document.getElementById('selectedCount');
const btnBatchComplete = document.getElementById('btnBatchComplete');
const btnBatchDelete = document.getElementById('btnBatchDelete');
const btnBatchCancel = document.getElementById('btnBatchCancel');
const addModal = document.getElementById('addModal');
const editModal = document.getElementById('editModal');
const deleteModal = document.getElementById('deleteModal');
const modalClose = document.getElementById('modalClose');
const editModalClose = document.getElementById('editModalClose');
const deleteModalClose = document.getElementById('deleteModalClose');
const btnCancel = document.getElementById('btnCancel');
const editBtnCancel = document.getElementById('editBtnCancel');
const deleteBtnCancel = document.getElementById('deleteBtnCancel');
const btnSubmit = document.getElementById('btnSubmit');
const editBtnSubmit = document.getElementById('editBtnSubmit');
const deleteBtnConfirm = document.getElementById('deleteBtnConfirm');
const btnDelete = document.getElementById('btnDelete');

// 详情弹窗元素
const detailModal = document.getElementById('detailModal');
const detailModalTitle = document.getElementById('detailModalTitle');
const detailModalClose = document.getElementById('detailModalClose');
