---
// src/pages/todo.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="待办清单" description="基于四象限理论的任务管理">
  <p id="todo-auth-status" role="status">正在检查登录状态…</p>
  <div id="todo-private" hidden inert>
  <div class="todo-page">
    <header class="todo-header">
      <div><h1>待办清单</h1><p class="todo-subtitle">按轻重缓急管理任务。</p></div>
      <div class="todo-actions">
        <button id="addTaskBtn" class="add-task-btn">＋ 新任务</button>
        <details class="todo-more"><summary aria-label="更多操作">更多 ···</summary><div class="todo-more-menu">
          <button id="batchModeBtn">批量操作</button><button id="clearCompletedBtn">清除已完成</button>
          <button id="exportJsonBtn">导出 JSON</button><button id="exportCsvBtn">导出 CSV</button>
        </div></details>
      </div>
    </header>
    <p class="sync-status" id="syncStatus" role="status"></p>
    <div class="import-banner" id="importBanner" hidden>
      <span class="import-text" id="importText"></span>
      <span class="import-actions"><button id="importConfirmBtn">导入到账号</button><button id="importDismissBtn">暂不导入</button></span>
    </div>
    <div class="stats-panel" aria-label="任务统计" aria-live="polite">
      <span><b id="stat-pending">0</b> 待办</span><span><b id="stat-today">0</b> 今天到期</span><span><b id="stat-completed">0</b> 已完成</span>
    </div>
    <div class="todo-toolbar">
      <div class="todo-filters" aria-label="按象限筛选">
        <button class="todo-filter active" data-filter="0" aria-pressed="true">全部任务</button>
        <button class="todo-filter quadrant-card" data-filter="1" data-quadrant="1" aria-pressed="false">立即处理 <span id="count-q1">0</span></button>
        <button class="todo-filter quadrant-card" data-filter="2" data-quadrant="2" aria-pressed="false">计划安排 <span id="count-q2">0</span></button>
        <button class="todo-filter quadrant-card" data-filter="3" data-quadrant="3" aria-pressed="false">委托简化 <span id="count-q3">0</span></button>
        <button class="todo-filter quadrant-card" data-filter="4" data-quadrant="4" aria-pressed="false">暂缓处理 <span id="count-q4">0</span></button>
      </div>
      <label class="category-filter">分类 <select id="categoryFilter" aria-label="按分类筛选"><option value="">全部分类</option></select></label>
      <div class="search-wrapper"><input type="search" id="searchInput" placeholder="搜索任务…" aria-label="搜索任务" class="search-input" /><button id="searchClearBtn" class="search-clear-btn" aria-label="清除搜索">×</button></div>
    </div>
    <div class="todo-split">
      <div class="todo-col-left">
        <div class="focus-list">
          <section id="group-overdue"><h2 class="task-group-title">已逾期 <span id="count-overdue"></span></h2><div class="task-list" id="list-overdue"></div></section>
          <section id="group-today"><h2 class="task-group-title">今天 <span id="count-today"></span></h2><div class="task-list" id="list-today"></div></section>
          <section id="group-upcoming"><h2 class="task-group-title">接下来 <span id="count-upcoming"></span></h2><div class="task-list" id="list-upcoming"></div></section>
          <section id="group-unscheduled"><h2 class="task-group-title">未安排日期 <span id="count-unscheduled"></span></h2><div class="task-list" id="list-unscheduled"></div></section>
          <div id="taskEmpty" class="task-empty" hidden>暂无待办，添加一件想完成的事。</div>
          <button class="list-add-btn" id="listAddBtn">＋ 添加任务</button>
        </div>
        <p class="todo-hint">拖动任务到上方象限筛选，可调整任务分类。</p>
      </div>
      <aside class="todo-col-right">
        <div class="calendar-view" id="calendarView">
          <div class="cal-toolbar"><button class="cal-nav-btn" id="prevMonthBtn" aria-label="上个月">‹</button><span class="cal-title" id="calTitle"></span><button class="cal-nav-btn" id="nextMonthBtn" aria-label="下个月">›</button><button class="cal-today-btn" id="todayBtn">今天</button></div>
          <div class="cal-weekdays"><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span><span>日</span></div>
          <div class="cal-grid" id="calGrid"></div><div class="cal-unscheduled" id="calUnscheduled"></div>
          <div id="calendarDayDetails" class="calendar-day-details" hidden><h3 id="calendarDayTitle"></h3><div id="calendarDayEvents"></div><button id="calendarDayAdd">＋ 为这一天添加任务</button></div>
          <details id="calendarSubscription" class="calendar-subscription" data-proxy={import.meta.env.PUBLIC_CALENDAR_PROXY_URL || ''}>
            <summary>日历订阅 · Apple 节假日</summary>
            <label for="subscriptionUrl">公开 ICS 地址</label><input id="subscriptionUrl" type="text" autocomplete="off" />
            <button id="subscriptionSave">验证并订阅</button>
            <label class="subscription-toggle"><input id="subscriptionEnabled" type="checkbox" />显示订阅事件</label>
            <div class="subscription-actions"><button id="subscriptionRefresh">立即更新</button><button id="subscriptionRemove">移除订阅</button></div>
            <p id="subscriptionStatus" role="status"></p><p>每小时检查更新；未来放假安排以来源已提供的信息为准。</p>
          </details>
          <p class="todo-hint">点击日期查看订阅事件并新建任务；点击任务圆点查看详情，拖动可改期。</p>
        </div>
        <div class="todo-progress"><h2>完成进度</h2><div class="progress-track"><div id="taskProgress"></div></div><p><span id="stat-rate">0%</span> · 共 <span id="stat-total">0</span> 项任务</p></div>
      </aside>
    </div>

    <!-- 归档：已完成任务（可折叠，通栏） -->
    <div class="todo-archive collapsed" id="todoArchive">
      <button class="archive-header" id="archiveToggle" aria-expanded="false">
        <span class="archive-title">已完成</span>
        <span class="archive-count" id="archiveCount">0</span>
        <span class="archive-arrow" aria-hidden="true">▾</span>
      </button>
      <div class="archive-body" id="archiveBody">
        <div class="archive-list" id="archiveList"></div>
      </div>
    </div>
  </div>

  <datalist id="todoCategories"></datalist>
<!-- 添加任务弹窗 -->
  <div class="modal-overlay" id="addModal">
    <div class="modal">
      <div class="modal-header">
        <h3>添加新任务</h3>
        <button class="modal-close" id="modalClose">&times;</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label for="taskTitle">任务标题 *</label>
          <input type="text" id="taskTitle" placeholder="输入任务标题" required />
        </div>
        <div class="form-group">
          <label for="taskDesc">描述（可选）</label>
          <textarea id="taskDesc" placeholder="输入任务描述" rows="3"></textarea>
        </div>
        <div class="form-group"><label for="taskCategory">分类（可选）</label><input id="taskCategory" type="text" list="todoCategories" maxlength="50" placeholder="例如：工作、生活、学习" /></div>
          <div class="form-group">
          <label for="taskDue">截止日期</label>
          <input type="date" id="taskDue" min="" />
        </div>
        <div class="form-group">
          <label>选择象限</label>
          <div class="quadrant-selector">
            <button class="quadrant-btn active" data-quadrant="1">Q1 重要紧急</button>
            <button class="quadrant-btn" data-quadrant="2">Q2 重要规划</button>
            <button class="quadrant-btn" data-quadrant="3">Q3 紧急次要</button>
            <button class="quadrant-btn" data-quadrant="4">Q4 低优先</button>
          </div>
        </div>
        <div class="form-group">
          <label>优先级</label>
          <div class="priority-selector">
            <button class="priority-btn" data-priority="high">高</button>
            <button class="priority-btn active" data-priority="medium">中</button>
            <button class="priority-btn" data-priority="low">低</button>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-cancel" id="btnCancel">取消</button>
        <button class="btn-submit" id="btnSubmit">添加任务</button>
      </div>
    </div>
  </div>

  <!-- 编辑任务弹窗 -->
  <div class="modal-overlay" id="editModal">
    <div class="modal">
      <div class="modal-header">
        <h3>编辑任务</h3>
        <button class="modal-close" id="editModalClose">&times;</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="editTaskId" />
        <div class="form-group">
          <label for="editTaskTitle">任务标题 *</label>
          <input type="text" id="editTaskTitle" placeholder="输入任务标题" required />
        </div>
        <div class="form-group">
          <label for="editTaskDesc">描述（可选）</label>
          <textarea id="editTaskDesc" placeholder="输入任务描述" rows="3"></textarea>
        </div>
        <div class="form-group"><label for="editTaskCategory">分类（可选）</label><input id="editTaskCategory" type="text" list="todoCategories" maxlength="50" placeholder="例如：工作、生活、学习" /></div>
          <div class="form-group">
          <label for="editTaskDue">截止日期</label>
          <input type="date" id="editTaskDue" />
        </div>
        <div class="form-group">
          <label>选择象限</label>
          <div class="quadrant-selector" id="editQuadrantSelector">
            <button class="quadrant-btn" data-quadrant="1">Q1 重要紧急</button>
            <button class="quadrant-btn" data-quadrant="2">Q2 重要规划</button>
            <button class="quadrant-btn" data-quadrant="3">Q3 紧急次要</button>
            <button class="quadrant-btn" data-quadrant="4">Q4 低优先</button>
          </div>
        </div>
        <div class="form-group">
          <label>优先级</label>
          <div class="priority-selector" id="editPrioritySelector">
            <button class="priority-btn" data-priority="high">高</button>
            <button class="priority-btn" data-priority="medium">中</button>
            <button class="priority-btn" data-priority="low">低</button>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-delete" id="btnDelete">删除</button>
        <button class="btn-cancel" id="editBtnCancel">取消</button>
        <button class="btn-submit" id="editBtnSubmit">保存修改</button>
      </div>
    </div>
  </div>

  <!-- 删除确认弹窗 -->
  <div class="modal-overlay" id="deleteModal">
    <div class="modal modal-small">
      <div class="modal-header">
        <h3>确认删除</h3>
        <button class="modal-close" id="deleteModalClose">&times;</button>
      </div>
      <div class="modal-body">
        <p>确定要删除这个任务吗？此操作不可恢复。</p>
      </div>
      <div class="modal-footer">
        <button class="btn-cancel" id="deleteBtnCancel">取消</button>
        <button class="btn-delete-confirm" id="deleteBtnConfirm">删除</button>
      </div>
    </div>
  </div>

  <!-- 批量操作面板 -->
  <div class="batch-actions-panel" id="batchActionsPanel">
    <span class="selected-count" id="selectedCount">已选择 0 个任务</span>
    <button class="btn-batch-complete" id="btnBatchComplete">批量完成</button>
    <button class="btn-batch-delete" id="btnBatchDelete">批量删除</button>
    <button class="btn-cancel" id="btnBatchCancel">取消</button>
  </div>

  <!-- 任务详情弹窗 -->
  <div class="modal-overlay" id="detailModal">
    <div class="modal">
      <div class="modal-header">
        <h3 id="detailModalTitle">任务详情</h3>
        <button class="modal-close" id="detailModalClose">&times;</button>
      </div>
      <div class="modal-body">
        <div class="detail-section">
          <label class="detail-label">标题</label>
          <p class="detail-value" id="detailTitle"></p>
        </div>
        <div class="detail-section">
          <label class="detail-label">描述</label>
          <p class="detail-value detail-desc-full" id="detailDesc"></p>
        </div>
        <div class="detail-meta-row">
          <div class="detail-section">
            <label class="detail-label">象限</label>
            <span class="detail-badge" id="detailQuadrant"></span>
          </div>
          <div class="detail-section">
            <label class="detail-label">优先级</label>
            <span class="detail-badge" id="detailPriority"></span>
          </div>
          <div class="detail-section">
            <label class="detail-label">截止日期</label>
            <span class="detail-value" id="detailDue"></span>
          </div>
          <div class="detail-section">
            <label class="detail-label">状态</label>
            <span class="detail-badge" id="detailStatus"></span>
          </div>
        </div>
        <div class="detail-section">
          <label class="detail-label">创建时间</label>
          <p class="detail-value" id="detailCreatedAt"></p>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-edit" id="detailBtnEdit">编辑</button>
        <button class="btn-cancel" id="detailBtnCancel">关闭</button>
      </div>
    </div>
  </div>

  <!-- Undo Toast -->
  <div class="undo-toast" id="undoToast">
    <span class="undo-message">任务已删除</span>
    <button class="undo-btn" id="undoBtn">撤销</button>
  </div>
  </div>
</BaseLayout>

<style is:inline>
 #todo-private[hidden]{display:none!important}

.todo-page{--todo-bg:#fff;--todo-text:#111827;--todo-muted:#6b7280;--todo-line:#e5e7eb;--todo-soft:#f9fafb;--todo-accent:#2563eb;--todo-tint:#eff6ff;color:var(--todo-text)}
.dark .todo-page{--todo-bg:#111827;--todo-text:#f3f4f6;--todo-muted:#9ca3af;--todo-line:#374151;--todo-soft:#1f2937;--todo-accent:#60a5fa;--todo-tint:#1e293b}
.todo-header{display:flex;align-items:center;justify-content:space-between;gap:16px}.todo-header h1{font-size:1.875rem;font-weight:700;margin:0}.todo-subtitle{font-size:.875rem;color:var(--todo-muted);margin:6px 0 0}.todo-actions{display:flex;gap:8px;align-items:center}.todo-page button{cursor:pointer}.todo-page button:focus-visible,.todo-page summary:focus-visible,.todo-page input:focus-visible{outline:2px solid var(--todo-accent);outline-offset:3px}.add-task-btn{background:var(--todo-accent);color:#fff;padding:9px 15px;border-radius:8px;font-size:.875rem}.dark .add-task-btn{background:#3b82f6}.todo-more{position:relative;font-size:.8rem}.todo-more summary{list-style:none;cursor:pointer;border:1px solid var(--todo-line);border-radius:8px;padding:9px 12px}.todo-more summary::-webkit-details-marker{display:none}.todo-more-menu{position:absolute;right:0;top:45px;width:156px;z-index:20;padding:5px;background:var(--todo-bg);border:1px solid var(--todo-line);border-radius:9px;box-shadow:0 8px 24px #0001}.todo-more-menu button{display:block;text-align:left;width:100%;padding:9px;border-radius:5px}.todo-more-menu button:hover{background:var(--todo-soft)}.stats-panel{display:flex;gap:22px;margin:24px 0;color:var(--todo-muted);font-size:.75rem}.stats-panel b{color:var(--todo-text);font-size:1.125rem;font-weight:600;margin-right:4px}.todo-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px}.todo-filters{display:flex;gap:3px;flex-wrap:wrap}.todo-filter{padding:7px 9px;border-radius:7px;font-size:.75rem;color:var(--todo-muted);white-space:nowrap}.todo-filter.active{background:var(--todo-tint);color:var(--todo-accent)}.todo-filter span{font-size:.65rem;opacity:.8;margin-left:3px}.todo-filter:hover{background:var(--todo-soft)}.todo-filter.drag-over{outline:2px dashed var(--todo-accent);background:var(--todo-tint)}.search-wrapper{position:relative;flex:0 1 190px}.search-input{width:100%;padding:8px 27px 8px 11px;border:1px solid var(--todo-line);border-radius:8px;background:var(--todo-bg);color:var(--todo-text);font-size:.8rem}.search-input::-webkit-search-cancel-button{display:none}.search-clear-btn{position:absolute;right:10px;top:7px;color:var(--todo-muted)}.todo-split{display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:20px;align-items:start}.todo-col-left,.todo-col-right{min-width:0}.focus-list{border:1px solid var(--todo-line);border-radius:12px;overflow:hidden;background:var(--todo-bg)}.task-group-title{font-size:.75rem;color:var(--todo-muted);font-weight:500;display:flex;gap:8px;padding:11px 16px;margin:0;background:var(--todo-soft)}.task-group-title span{font-size:.65rem}.task-list{min-width:0}.task-item{display:flex;align-items:flex-start;gap:10px;padding:17px 16px;border-top:1px solid var(--todo-line);position:relative;cursor:grab}.task-item:hover,.task-item:focus-within{background:var(--todo-soft)}.task-content{flex:1;min-width:0}.task-title{font-size:.875rem;font-weight:500;text-align:left;line-height:1.6;background:transparent;padding:0;overflow-wrap:anywhere}.task-title:hover{color:var(--todo-accent)}.task-desc{font-size:.75rem;color:var(--todo-muted);margin:3px 0;overflow:hidden;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow-wrap:anywhere}.task-meta{display:flex;flex-wrap:wrap;gap:7px;margin-top:5px;font-size:.65rem;color:var(--todo-muted)}.task-due.overdue{color:#b45353}.dark .task-due.overdue{color:#fca5a5}.task-priority{background:var(--todo-soft);padding:0 5px;border-radius:4px}.task-priority.high{color:#b45353}.dark .task-priority.high{color:#fca5a5}.task-quadrant.q2{color:var(--todo-accent)}.task-checkbox,.task-batch-checkbox{width:17px;height:17px;border:1.5px solid var(--todo-line);border-radius:5px;flex-shrink:0;margin-top:3px;background:var(--todo-bg)}.task-checkbox:hover,.task-batch-checkbox:hover{border-color:var(--todo-accent)}.task-checkbox.checked,.task-batch-checkbox.checked{background:var(--todo-accent);border-c