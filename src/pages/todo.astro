// 创建任务项 DOM
function createTaskElement(task: TodoItem): HTMLElement {
  const item = document.createElement('div');
  item.className = `task-item${task.completed ? ' completed' : ''}${isDueSoon(task.dueDate) || isOverdue(task.dueDate) ? ' due-warning' : ''}${batchModeActive ? ' batch-mode' : ''}`;
  item.dataset.id = task.id;
  item.draggable = !batchModeActive; // 批量模式下禁用拖拽

  const dueText = task.dueDate ? formatDate(task.dueDate) : '';
  const overdueClass = isOverdue(task.dueDate) ? 'overdue' : '';

  // 安全构建 DOM，避免 XSS
  const particlesDiv = document.createElement('div');
  particlesDiv.className = 'completion-particles';
  particlesDiv.id = `particles-${task.id}`;

  // 批量选择复选框
  const batchCheckboxDiv = document.createElement('button');
  batchCheckboxDiv.className = `task-batch-checkbox${selectedTaskIds.has(task.id) ? ' checked' : ''}`;
  batchCheckboxDiv.dataset.id = task.id;
  batchCheckboxDiv.setAttribute('aria-label', `选择任务：${task.title}`);
  batchCheckboxDiv.setAttribute('aria-pressed', String(selectedTaskIds.has(task.id)));

  const checkboxDiv = document.createElement('button');
  checkboxDiv.className = `task-checkbox${task.completed ? ' checked' : ''}`;
  checkboxDiv.dataset.id = task.id;
  checkboxDiv.setAttribute('aria-label', `完成任务：${task.title}`);
  checkboxDiv.setAttribute('aria-pressed', String(task.completed));

  const contentDiv = document.createElement('div');
  contentDiv.className = 'task-content';

  const titleP = document.createElement('button');
  titleP.className = 'task-title';
  titleP.textContent = task.title; // 使用 textContent 避免 XSS

  contentDiv.appendChild(titleP);

  if (task.description) {
    const descP = document.createElement('p');
    descP.className = 'task-desc';
    descP.textContent = task.description; // 使用 textContent 避免 XSS
    contentDiv.appendChild(descP);
  }

  const metaDiv = document.createElement('div');
  metaDiv.className = 'task-meta';

  if (dueText) {
    const dueSpan = document.createElement('span');
    dueSpan.className = `task-due ${overdueClass}`;
    dueSpan.textContent = `${isOverdue(task.dueDate) ? '已逾期 · ' : ''}${dueText}`;
    metaDiv.appendChild(dueSpan);
  }

  const prioritySpan = document.createElement('span');
  prioritySpan.className = `task-priority ${task.priority}`;
  prioritySpan.textContent = task.priority === 'high' ? '高优先' : task.priority === 'medium' ? '中优先' : '低优先';
  const quadrantSpan = document.createElement('span');
  quadrantSpan.className = `task-quadrant q${task.quadrant}`;
  quadrantSpan.textContent = { 1: '重要且紧急', 2: '重要不紧急', 3: '紧急不重要', 4: '暂缓处理' }[task.quadrant];
  metaDiv.appendChild(quadrantSpan);
  metaDiv.appendChild(prioritySpan);
  if (task.category) {
    const category = document.createElement('span');
    category.className = 'task-category';
    category.textContent = task.category;
    metaDiv.appendChild(category);
  }

  contentDiv.appendChild(metaDiv);

  const actionsDiv = document.createElement('div');
  actionsDiv.className = 'task-actions';

  const editBtn = document.createElement('button');
  editBtn.className = 'task-action-btn edit';
  editBtn.dataset.id = task.id;
  editBtn.title = '编辑';
  editBtn.textContent = '编辑';

  const deleteBtn = document.createElement('button');
  deleteBtn.className = 'task-action-btn delete';
  deleteBtn.dataset.id = task.id;
  deleteBtn.title = '删除';
  deleteBtn.textContent = '删除';

  actionsDiv.appendChild(editBtn);
  actionsDiv.appendChild(deleteBtn);

  item.appendChild(particlesDiv);
  item.appendChild(batchCheckboxDiv);
  item.appendChild(checkboxDiv);
  item.appendChild(contentDiv);
  item.appendChild(actionsDiv);

  return item;
}

// 创建归档（已完成）任务的紧凑条目，全程 createElement + textContent 防 XSS
function createArchiveItem(task: TodoItem): HTMLElement {
  const item = document.createElement('div');
  item.className = 'archive-item';
  item.dataset.id = task.id;

  const titleP = document.createElement('p');
  titleP.className = 'archive-item-title'; // 不用 task-title，避免被 .task-list 委托误捕获
  titleP.textContent = task.title;
  item.appendChild(titleP);

  const time = document.createElement('span');
  time.className = 'archive-item-time';
  time.textContent = task.completedAt ? `✔ ${formatDateTime(task.completedAt)}` : '✔ 已完成';
  item.appendChild(time);

  const actions = document.createElement('div');
  actions.className = 'archive-item-actions';

  const restoreBtn = document.createElement('button');
  restoreBtn.className = 'archive-action-btn restore';
  restoreBtn.dataset.id = task.id;
  restoreBtn.title = '恢复到待办';
  restoreBtn.textContent = '↩';

  const deleteBtn = document.createElement('button');
  deleteBtn.className = 'archive-action-btn delete';
  deleteBtn.dataset.id = task.id;
  deleteBtn.title = '删除';
  deleteBtn.textContent = '删除';

  actions.appendChild(restoreBtn);
  actions.appendChild(deleteBtn);
  item.appendChild(actions);

  return item;
}

// 创建完成粒子效果
function createCompletionParticles(taskId: string) {
  const container = document.getElementById(`particles-${taskId}`);
  if (!container) return;

  const colors = ['#10b981', '#34d399', '#6ee7b7'];
  for (let i = 0; i < 8; i++) {
    const particle = document.createElement('div');
    particle.className = 'particle';
    const angle = (Math.PI * 2 * i) / 8;
    const velocity = 30 + Math.random() * 20;
    const tx = Math.cos(angle) * velocity;
    const ty = Math.sin(angle) * velocity;

    particle.style.cssText = `
      background: ${colors[Math.floor(Math.random() * colors.length)]};
      --tx: ${tx}px;
      --ty: ${ty}px;
    `;

    particle.animate([
      { transform: 'translate(-50%, -50%) scale(1)', opacity: 1 },
      { transform: `translate(calc(-50% + ${tx}px), calc(-50% + ${ty}px)) scale(0)`, opacity: 0 }
    ], {
      duration: 500,
      easing: 'cubic-bezier(0, 0.8, 0.2, 1)',
      fill: 'forwards'
    });

    container.appendChild(particle);
  }
}

// 渲染专注清单；保留原存储结构与象限分类。
function renderTasks(filter: string = searchInput.value) {
  const storage = getStorage();
  const query = filter.trim().toLowerCase();
  const categoryFilter = document.getElementById('categoryFilter') as HTMLSelectElement;
  const selectedCategory = categoryFilter.value;
  const categories = [...new Set(storage.items.map(item => item.category).filter((value): value is string => !!value))].sort();
  categoryFilter.replaceChildren(new Option('全部分类', ''), new Option('未分类', '__uncategorized__'), ...categories.map(category => new Option(category, category)));
  categoryFilter.value = selectedCategory;
  if (categoryFilter.selectedIndex < 0) categoryFilter.value = '';
  document.getElementById('todoCategories')?.replaceChildren(...categories.map(category => new Option(category, category)));
  const pending = storage.items.filter(item => !item.completed);
  const visible = pending.filter(item => (!categoryFilter.value || (categoryFilter.value === '__uncategorized__' ? !item.category : item.category === categoryFilter.value)) && (!activeQuadrant || item.quadrant === activeQuadrant) &&
    (!query || item.title.toLowerCase().includes(query) || item.description?.toLowerCase().includes(query)));
  const now = new Date();
  const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
  const tomorrowStart = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1).getTime();
  const groups: Record<string, TodoItem[]> = { overdue: [], today: [], upcoming: [], unscheduled: [] };
  visible.forEach(item => {
    const group = !item.dueDate ? 'unscheduled' : item.dueDate < todayStart ? 'overdue' : item.dueDate < tomorrowStart ? 'today' : 'upcoming';
    groups[group].push(item);
  });
  Object.entries(groups).forEach(([group, items]) => {
    items.sort((a, b) => (a.dueDate || Infinity) - (b.dueDate || Infinity) || getPriorityOrder(b.priority) - getPriorityOrder(a.priority) || b.createdAt - a.createdAt);
    const list = document.getElementById('list-' + group)!;
    list.replaceChildren(...items.map(createTaskElement));
    document.getElementById('group-' + group)!.hidden = items.length === 0;
    document.getElementById('count-' + group)!.textContent = String(items.length);
  });
  const empty = document.getElementById('taskEmpty')!;
  empty.hidden = visible.length > 0;
  empty.textContent = query ? '没有匹配的任务，试试其他关键词。' : activeQuadrant ? '这个象限暂无待办。' : '暂无待办，添加一件想完成的事。';
  [1, 2, 3, 4].forEach(q => { document.getElementById('count-q' + q)!.textContent = String(pending.filter(item => item.quadrant === q).length); });
  const completed = storage.items.length - pending.length;
  const rate = storage.items.length ? Math.round(completed / storage.items.length * 100) : 0;
  document.getElementById('stat-pending')!.textContent = String(pending.length);
  document.getElementById('stat-completed')!.textContent = String(completed);
  document.getElementById('stat-total')!.textContent = String(storage.items.length);
  document.getElementById('stat-today')!.textContent = String(pending.filter(item => item.dueDate && item.dueDate >= todayStart && item.dueDate < tomorrowStart).length);
  document.getElementById('stat-rate')!.textContent = rate + '%';
  document.getElementById('taskProgress')!.style.width = rate + '%';
  searchClearBtn!.hidden = !searchInput.value;
  renderCalendar(filter);
  renderArchive(filter);
}

// 渲染归档面板（已完成任务，按完成时间降序）
function renderArchive(filter?: string) {
  const listEl = document.getElementById('archiveList');
  const countEl = document.getElementById('archiveCount');
  if (!listEl) return;

  const storage = getStorage();
  const category = (document.getElementById('categoryFilter') as HTMLSelectElement).value;
  let items = storage.items.filter(i => i.completed && (!category || (category === '__uncategorized__' ? !i.category : i.category === category)));

  if (filter) {
    const lowerFilter = filter.toLowerCase();
    items = items.filter(item =>
      item.title.toLowerCase().includes(lowerFilter) ||
      (item.description && item.description.toLowerCase().includes(lowerFilter))
    );
  }

  // 最近完成在前
  items.sort((a, b) => (b.completedAt || 0) - (a.completedAt || 0));

  listEl.innerHTML = '';
  if (items.length === 0) {
    const empty = document.createElement('div');
    empty.className = 'archive-empty';
    empty.textContent = filter ? '没有匹配的已完成任务' : '暂无已完成任务';
    listEl.appendChild(empty);
  } else {
    items.forEach(task => listEl.appendChild(createArchiveItem(task)));
  }

  if (countEl) countEl.textContent = String(items.length);
}

// ============ 日历视图渲染 ============

// 创建日历内的紧凑任务条（独立于 createTaskElement，全程 createElement + textContent 防 XSS）
function createCalChip(task: TodoItem): HTMLElement {
  const chip = document.createElement('div');
  chip.className = `cal-chip${task.completed ? ' completed' : ''}${isOverdue(task.dueDate) && !task.completed ? ' overdue' : ''}`;
  chip.draggable = true;
  chip.dataset.id = task.id;
  chip.title = task.title;
  chip.setAttribute('aria-label', task.title);
  chip.tabIndex = 0;

  const dot = document.createElement('span');
  dot.className = `cal-chip-dot ${task.priority}`;
  chip.appendChild(dot);

  if (task.dueDate) {
    const date = new Date(task.dueDate);
    const timeSpan = document.createElement('span');
    timeSpan.className = 'cal-chip-time';
    timeSpan.textContent = `${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}`;
    chip.appendChild(timeSpan);
  }

  const titleSpan = document.createElement('span');
  titleSpan.className = 'cal-chip-title';
  titleSpan.textContent = task.title;
  chip.appendChild(titleSpan);

  return chip;
}

// 渲染月历
function renderCalendar(filter?: string) {
  const calTitle = document.getElementById('calTitle');
  const calGrid = document.getElementById('calGrid');
  const calUnscheduled = document.getElementById('calUnscheduled');
  if (!calTitle || !calGrid || !calUnscheduled) return;

  calTitle.textContent = `${calYear}年${calMonth + 1}月`;

  // 按本地日期把任务分组到日期桶（避开 UTC 时区错位）
  const storage = getStorage();
  let items = storage.items;
  if (filter) {
    const lowerFilter = filter.toLowerCase();
    items = items.filter(item =>
      item.title.toLowerCase().includes(lowerFilter) ||
      (item.description && item.description.toLowerCase().includes(lowerFilter))
    );
  }

  const buckets = new Map<string, TodoItem[]>();
  const unscheduled: TodoItem[] = [];
  items.forEach(item => {
    if (!item.dueDate) {
      unscheduled.push(item);
      return;
    }
    const key = formatDate(item.dueDate);
    if (!buckets.has(key)) buckets.set(key, []);
    buckets.get(key)!.push(item);
  });

  // 格内排序：未完成在前 → 截止日期升序 → 优先级降序
  buckets.forEach(list => {
    list.sort((a, b) => {
      if (a.completed !== b.completed) return a.completed ? 1 : -1;
      const dueDiff = (a.dueDate || 0) - (b.dueDate || 0);
      if (dueDiff !== 0) return dueDiff;
      return getPriorityOrder(b.priority) - getPriorityOrder(a.priority);
    });
  });

  // 42 格（6 周）布局，周一起
  const first = new Date(calYear, calMonth, 1);
  const lead = (first.getDay() + 6) % 7; // 周一起的首日偏移
  const gridStart = new Date(calYear, calMonth, 1 - lead);
  const todayKey = formatDate(Date.now());
  const maxPerDay = window.innerWidth <= 768 ? 2 : CAL_MAX_PER_DAY;

  const fragment = document.createDocumentFragment();
  for (let i = 0; i < 42; i++) {
    const d = new Date(gridStart);
    d.setDate(gridStart.getDate() + i);
    const key = formatDate(d.getTime());

    const cell = document.createElement('div');
    cell.className = 'cal-cell';
    if (d.getMonth() !== calMonth) cell.classList.add('cal-cell-other');
    if (key === todayKey) cell.classList.add('cal-cell-today');
    cell.dataset.date = key;
    cell.tabIndex = 0;
    cell.setAttribute('role', 'button');
    cell.setAttribute('aria-label', `在 ${key} 添加任务`);

    const dateLabel = document.createElement('span');
    dateLabel.className = 'cal-date';
    dateLabel.textContent = String(d.getDate());
    cell.appendChild(dateLabel);
    const holidayEvents = subscription?.getEvents(key) || [];
    if (holidayEvents.length) {
      const special = holidayEvents.find(event => event.kind !== 'event');
      const badge = document.createElement('span');
      badge.className = `holiday-marker ${special?.kind || 'event'}`;
      badge.textContent = special?.kind === 'holiday' ? '休' : special?.kind === 'workday' ? '班' : '·';
      badge.title = holidayEvents.map(event => event.title).join('、');
      cell.appendChild(badge);
      cell.setAttribute('aria-label', `${key}：${badge.title}`);
    }

    const dayTasks = buckets.get(key) || [];
    const expanded = expandedDays.has(key);
    const visible = expanded ? dayTasks : dayTasks.slice(0, maxPerDay);
    visible.forEach(task => cell.appendChild(createCalChip(task)));

    if (!expanded && dayTasks.length > maxPerDay) {
      const more = document.createElement('div');
      more.className = 'cal-more';
      more.dataset.date = key;
      more.textContent = `+${dayTasks.length - maxPerDay} 更多`;
      cell.appendChild(more);
    }

    fragment.appendChild(cell);
  }

  calGrid.innerHTML = '';
  calGrid.appendChild(fragment);

  // 无截止日期任务区
  calUnscheduled.innerHTML = '';
  if (unscheduled.length > 0) {
    const label = document.createElement('span');
    label.className = 'cal-unscheduled-label';
    label.textContent = '无截止日期：';
    calUnscheduled.appendChild(label);
    unscheduled.forEach(task => calUnscheduled.appendChild(createCalChip(task)));
  }
}

// 弹窗操作
function showModal(modal: HTMLElement) {
  // 设置日期最小值
  setDateMinToday();
  modal.style.display = 'flex';
  requestAnimationFrame(() => modal.classList.add('show'));
}

function hideModal(modal: HTMLElement, clearForm = false) {
  modal.classList.remove('show');
  setTimeout(() => modal.style.display = 'none', 300);
  // 清空表单（用于取消操作）
  if (clearForm && modal === addModal) {
    clearAddForm();
  }
}

// 添加任务
function addTask() {
  const title = taskTitle.value.trim();
  if (!title) return;

  const storage = getStorage();
  const task: TodoItem = {
    id: newTodoId(),
    title,
    description: taskDesc.value.trim() || undefined,
    category: (document.getElementById('taskCategory') as HTMLInputElement).value.trim() || undefined,
    quadrant: currentQuadrant,
    createdAt: Date.now(),
    updatedAt: Date.now(),
    dueDate: dateToDeadline(taskDue.value),
    completed: false,
    priority: currentPriority
  };

  storage.items.push(task);
  saveStorage();

  // 重置表单
  taskTitle.value = '';
  taskDesc.value = '';
  taskDue.value = formatDateInput(Date.now());
  (document.getElementById('taskCategory') as HTMLInputElement).value = '';
  currentQuadrant = 1;
  currentPriority = 'medium';
  updateQuadrantBtns(quadrantBtns, currentQuadrant);
  updatePriorityBtns(priorityBtns, currentPriority);

  hideModal(addModal!);
  renderTasks(searchInput.value);
}

// 编辑任务
function openEditModal(taskId: string) {
  const storage = getStorage();
  const task = storage.items.find(i => i.id === taskId);
  if (!task) return;

  editingTaskId = taskId;

  editTaskId.value = taskId;
  editTaskTitle.value = task.title;
  editTaskDesc.value = task.description || '';
  (document.getElementById('editTaskCategory') as HTMLInputElement).value = task.category || '';
  editTaskDue.value = task.dueDate ? formatDateInput(task.dueDate) : '';

  currentQuadrant = task.quadrant;
  currentPriority = task.priority;
  updateQuadrantBtns(editQuadrantBtns, currentQuadrant);
  updatePriorityBtns(editPriorityBtns, currentPriority);

  showModal(editModal!);
}

function saveEdit() {
  const title = editTaskTitle.value.trim();
  if (!title || !editingTaskId) return;

  const storage = getStorage();
  const task = storage.items.find(i => i.id === editingTaskId);
  if (!task) return;

  task.title = title;
  task.description = editTaskDesc.value.trim() || undefined;
  task.category = (document.getElementById('editTaskCategory') as HTMLInputElement).value.trim() || undefined;
  task.quadrant = currentQuadrant;
  task.priority = currentPriority;
  task.dueDate = dateToDeadline(editTaskDue.value);
  task.updatedAt = Date.now();

  saveStorage();
  hideModal(editModal!);
  editingTaskId = null;
  renderTasks(searchInput.value);
}

// 删除任务
function openDeleteModal(taskId: string) {
  deletingTaskId = taskId;
  showModal(deleteModal!);
}

function confirmDelete() {
  if (!deletingTaskId) return;

  const storage = getStorage();
  const taskToDelete = storage.items.find(i => i.id === deletingTaskId);

  if (taskToDelete) {
    // 保存已删除的任务用于撤销
    lastDeletedTask = taskToDelete;
    storage.items = storage.items.filter(i => i.id !== deletingTaskId);
    saveStorage();

    // 显示撤销提示
    showUndoToast(taskToDelete);
  }

  hideModal(deleteModal!);
  deletingTaskId = null;
  renderTasks(searchInput.value);
}

// 完成任务
function toggleComplete(taskId: string) {
  const storage = getStorage();
  const task = storage.items.find(i => i.id === taskId);
  if (!task) return;

  task.completed = !task.completed;
  task.completedAt = task.completed ? Date.now() : undefined;
  task.updatedAt = Date.now();

  saveStorage();

  if (task.completed) {
    createCompletionParticles(taskId);
  }

  renderTasks(searchInput.value);
}

// 恢复已完成任务：取消完成，退回原象限（quadrant 不变）
function restoreTask(taskId: string) {
  const storage = getStorage();
  const task = storage.items.find(i => i.id === taskId);
  if (!task) return;

  task.completed = false;
  task.completedAt = undefined;
  task.updatedAt = Date.now();

  saveStorage();
  renderTasks(searchInput.value);
}

// 折叠/展开归档面板
function toggleArchive() {
  const archive = document.getElementById('todoArchive');
  if (!archive) return;
  const collapsed = archive.classList.toggle('collapsed');
  document.getElementById('archiveToggle')?.setAttribute('aria-expanded', String(!collapsed));
}

// 更新按钮状态
function updateQuadrantBtns(btns: NodeListOf<Element>, quadrant: number) {
  btns.forEach(btn => {
    const q = parseInt(btn.getAttribute('data-quadrant') || '1');
    btn.classList.toggle('active', q === quadrant);
  });
}

function updatePriorityBtns(btns: NodeListOf<Element>, priority: string) {
  btns.forEach(btn => {
    const p = btn.getAttribute('data-priority') || 'medium';
    btn.classList.toggle('active', p === priority);
  });
}

// 批量模式相关函数
function toggleBatchMode() {
  batchModeActive = !batchModeActive;
  selectedTaskIds.clear();
  batchModeBtn?.classList.toggle('active', batchModeActive);
  batchActionsPanel?.classList.toggle('show', batchModeActive);
  updateSelectedCount();
  renderTasks(searchInput.value);
}

function toggleBatchSelection(taskId: string) {
  if (selectedTaskIds.has(taskId)) {
    selectedTaskIds.delete(taskId);
  } else {
    selectedTaskIds.add(taskId);
  }
  updateSelectedCount();
  renderTasks(searchInput.value);
}

function updateSelectedCount() {
  if (selectedCountEl) {
    selectedCountEl.textContent = `已选择 ${selectedTaskIds.size} 个任务`;
  }
}

function batchComplete() {
  if (selectedTaskIds.size === 0) return;
  const storage = getStorage();
  storage.items.forEach(item => {
    if (selectedTaskIds.has(item.id)) {
      item.completed = true;
      item.completedAt = Date.now();
      item.updatedAt = Date.now();
    }
  });
  saveStorage();
  selectedTaskIds.clear();
  updateSelectedCount();
  renderTasks(searchInput.value);
}

function batchDelete() {
  if (selectedTaskIds.size === 0) return;
  const storage = getStorage();
  storage.items = storage.items.filter(i => !selectedTaskIds.has(i.id));
  saveStorage();
  selectedTaskIds.clear();
  updateSelectedCount();
  renderTasks(searchInput.value);
}

function clearCompletedTasks() {
  const storage = getStorage();
  const completedCount = storage.items.filter(i => i.completed).length;
  if (completedCount === 0) return;
  storage.items = storage.items.filter(i => !i.completed);
  saveStorage();
  renderTasks(searchInput.value);
}

// 搜索防抖
function debounceSearch(callback: () => void, delay = 300) {
  if (searchDebounceTimer) {
    clearTimeout(searchDebounceTimer);
  }
  searchDebounceTimer = window.setTimeout(callback, delay);
}

// 任务详情功能
function openDetailModal(taskId: string) {
  const storage = getStorage();
  const task = storage.items.find(i => i.id === taskId);
  if (!task) return;

  viewingTaskId = taskId;

  if (detailModalTitle) detailModalTitle.textContent = '任务详情';
  if (detailTitle) detailTitle.textContent = task.title;
  if (detailDesc) detailDesc.textContent = task.description || '暂无描述';

  const quadrantNames = { 1: 'Q1 重要紧急', 2: 'Q2 重要规划', 3: 'Q3 紧急次要', 4: 'Q4 低优先' };
  if (detailQuadrant) {
    detailQuadrant.textContent = quadrantNames[task.quadrant] + ' · ' + (task.category || '未分类');
    detailQuadrant.className = `detail-badge q${task.quadrant}`;
  }

  const priorityNames = { high: '高', medium: '中', low: '低' };
  if (detailPriority) {
    detailPriority.textContent = priorityNames[task.priority];
    detailPriority.className = `detail-badge ${task.priority}`;
  }

  if (detailDue) {
    detailDue.textContent = task.dueDate ? formatDate(task.dueDate) : '无截止日期';
    if (isOverdue(task.dueDate)) {
      detailDue.style.color = '#ef4444';
    } else {
      detailDue.style.color = '';
    }
  }

  if (detailStatus) {
    detailStatus.textContent = task.completed ? '已完成' : '待处理';
    detailStatus.className = `detail-badge ${task.completed ? 'completed' : 'pending'}`;
  }

  if (detailCreatedAt) {
    const createdDate = new Date(task.createdAt);
    detailCreatedAt.textContent = `${formatDate(task.createdAt)} ${createdDate.getHours()}:${String(createdDate.getMinutes()).padStart(2, '0')}`;
  }

  showModal(detailModal!);
}

// Undo 功能
function showUndoToast(task: TodoItem) {
  lastDeletedTask = task;
  undoToast?.classList.add('show');

  // 5秒后自动隐藏
  if (undoTimer) clearTimeout(undoTimer);
  undoTimer = window.setTimeout(() => {
    hideUndoToast();
    lastDeletedTask = null;
  }, 5000);
}

function hideUndoToast() {
  undoToast?.classList.remove('show');
  if (undoTimer) {
    clearTimeout(undoTimer);
    undoTimer = null;
  }
}

function undoDelete() {
  if (!lastDeletedTask) return;

  const storage = getStorage();
  storage.items.push(lastDeletedTask);
  saveStorage();
  hideUndoToast();
  lastDeletedTask = null;
  renderTasks(searchInput.value);
}

// 导出功能
function exportToJson() {
  const storage = getStorage();
  const dataStr = JSON.stringify(storage, null, 2);
  const blob = new Blob([dataStr], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `todo_backup_${formatDate(Date.now())}.json`;
  a.click();
  URL.revokeObjectURL(url);
}

function exportToCsv() {
  const storage = getStorage();
  const headers = ['ID', '标题', '描述', '象限', '优先级', '截止日期', '状态', '创建时间'];
  const rows = storage.items.map(item => [
    item.id,
    item.title,
    item.description || '',
    item.quadrant,
    item.priority,
    item.dueDate ? formatDate(item.dueDate) : '',
    item.completed ? '已完成' : '待处理',
    formatDate(item.createdAt)
  ]);

  const csvContent = [headers, ...rows].map(row => row.map(cell => `"${cell}"`).join(',')).join('\n');
  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `todo_backup_${formatDate(Date.now())}.csv`;
  a.click();
  URL.revokeObjectURL(url);
}

// 浏览器通知功能
function requestNotificationPermission() {
  if (userId && !privatePanel.hidden && 'Notification' in window && Notification.permission === 'default') {
    Notification.requestPermission();
  }
}

function checkDeadlineNotifications() {
  if (!userId || privatePanel.hidden) return;
  if ('Notification' in window && Notification.permission === 'granted') {
    const storage = getStorage();
    storage.items.forEach(item => {
      if (item.completed || !item.dueDate) return;

      const dueDayStart = new Date(item.dueDate);
      dueDayStart.setHours(0, 0, 0, 0);
      const todayStart = new Date();
      todayStart.setHours(0, 0, 0, 0);
      if (dueDayStart.getTime() === todayStart.getTime()) {
        new Notification(`任务今天截止: ${item.title}`, {
          body: '这是今天到期的任务。',
          icon: '/favicon.ico'
        });
      }
    });
  }
}

// 拖拽功能
let draggedItem: HTMLElement | null = null;
let dragPlaceholder: HTMLElement | null = null;

function handleDragStart(e: DragEvent) {
  draggedItem = e.target as HTMLElement;
  if (!draggedItem.classList.contains('task-item')) return;

  draggedItem.classList.add('dragging');
  e.dataTransfer!.effectAllowed = 'move';
  e.dataTransfer!.setData('text/plain', draggedItem.dataset.id || '');

  // 创建占位符
  dragPlaceholder = document.createElement('div');
  dragPlaceholder.className = 'drag-placeholder';
  dragPlaceholder.style.height = draggedItem.offsetHeight + 'px';

  // 延迟添加占位符，让拖拽开始
  setTimeout(() => {
    if (draggedItem && draggedItem.parentElement) {
      draggedItem.parentElement.insertBefore(dragPlaceholder!, draggedItem.nextSibling);
    }
  }, 0);
}

function handleDragEnd(e: Event) {
  if (draggedItem) {
    draggedItem.classList.remove('dragging');
    draggedItem.style.opacity = '';
    draggedItem = null;
  }
  if (dragPlaceholder) {
    dragPlaceholder.remove();
    dragPlaceholder = null;
  }
  // 移除所有拖拽提示样式
  document.querySelectorAll('.quadrant-card').forEach(card => {
    card.classList.remove('drag-over');
  });
}

function handleDragOver(e: DragEvent) {
  e.preventDefault();
  e.dataTransfer!.dropEffect = 'move';

  const targetCard = (e.target as HTMLElement).closest('.quadrant-card');
  if (targetCard) {
    // 添加拖拽提示样式
    document.querySelectorAll('.quadrant-card').forEach(card => {
      card.classList.remove('drag-over');
    });
    targetCard.classList.add('drag-over');
  }

  // 同象限内排序
  if (draggedItem && dragPlaceholder) {
    const targetList = (e.target as HTMLElement).closest('.task-list');
    if (targetList && targetList === draggedItem.parentElement) {
      const afterElement = getDragAfterElement(targetList, e.clientY);
      if (afterElement && afterElement !== dragPlaceholder) {
        targetList.insertBefore(dragPlaceholder, afterElement);
      } else if (!afterElement && targetList.lastElementChild !== dragPlaceholder) {
        targetList.appendChild(dragPlaceholder);
      }
    }
  }
}

function handleDrop(e: DragEvent) {
  e.preventDefault();
  if (!draggedItem) return;

  const targetCard = (e.target as HTMLElement).closest('.quadrant-card');
  if (!targetCard) return;

  const targetList = targetCard.querySelector('.task-list');
  const newQuadrant = parseInt(targetCard.getAttribute('data-quadrant') || '1') as 1 | 2 | 3 | 4;
  const taskId = draggedItem.dataset.id;

  if (taskId) {
    const storage = getStorage();
    const task = storage.items.find(i => i.id === taskId);
    if (task) {
      // 更新象限
      if (task.quadrant !== newQuadrant) {
        task.quadrant = newQuadrant;
        task.updatedAt = Date.now();
      }

      // 同象限内排序 - 计算新位置
      if (targetList && dragPlaceholder) {
        const tasksInQuadrant = storage.items.filter(i => i.quadrant === newQuadrant && !i.completed);
        const afterElement = getDragAfterElement(targetList, e.clientY);

        // 找到插入位置
        let newIndex = tasksInQuadrant.length - 1;
        if (afterElement && afterElement.classList.contains('task-item')) {
          const afterId = afterElement.dataset.id;
          const afterTask = tasksInQuadrant.find(i => i.id === afterId);
          if (afterTask) {
            newIndex = tasksInQuadrant.indexOf(afterTask);
          }
        }

        // 更新排序（通过调整 updatedAt）
        const baseTime = Date.now();
        tasksInQuadrant.forEach((t, idx) => {
          if (t.id === taskId) {
            t.updatedAt = baseTime + (newIndex * 1000);
          } else if (idx >= newIndex) {
            t.updatedAt = baseTime + ((idx + 1) * 1000);
          }
        });
      }

      saveStorage();
      renderTasks(searchInput.value);
    }
  }

  // 清理
  handleDragEnd(e);
}

function getDragAfterElement(container: Element, y: number): HTMLElement | null {
  const draggableElements = [...container.querySelectorAll<HTMLElement>('.task-item:not(.dragging), .drag-placeholder')];

  return draggableElements.reduce((closest, child) => {
    const box = child.getBoundingClientRect();
    const offset = y - box.top - box.height / 2;

    if (offset < 0 && offset > closest.offset) {
      return { offset: offset, element: child };
    } else {
      return closest;
    }
  }, { offset: Number.NEGATIVE_INFINITY, element: null as HTMLElement | null }).element;
}

// ============ 日历视图交互 ============

// 月份导航
function changeMonth(delta: number) {
  const d = new Date(calYear, calMonth + delta, 1);
  calYear = d.getFullYear();
  calMonth = d.getMonth();
  expandedDays.clear();
  renderCalendar(searchInput.value);
}

function goToToday() {
  const now = new Date();
  calYear = now.getFullYear();
  calMonth = now.getMonth();
  expandedDays.clear();
  renderCalendar(searchInput.value);
}

// 拖拽改期
function handleCalDragStart(e: DragEvent) {
  const chip = (e.target as HTMLElement).closest('.cal-chip') as HTMLElement | null;
  if (!chip) return;
  calDraggedId = chip.dataset.id || null;
  chip.classList.add('dragging');
  e.dataTransfer!.effectAllowed = 'move';
  e.dataTransfer!.setData('text/plain', calDraggedId || '');
}

function handleCalDragOver(e: DragEvent) {
  if (!calDraggedId) return;
  e.preventDefault();
  e.dataTransfer!.dropEffect = 'move';
  const cell = (e.target as HTMLElement).closest('.cal-cell');
  if (cell) {
    document.querySelectorAll('.cal-cell.cal-drop-over').forEach(c => c.classList.remove('cal-drop-over'));
    cell.classList.add('cal-drop-over');
  }
}

function handleCalDrop(e: DragEvent) {
  e.preventDefault();
  e.stopPropagation();
  const cell = (e.target as HTMLElement).closest('.cal-cell') as HTMLElement | null;
  if (!cell || !calDraggedId || !cell.dataset.date) return;

  const [y, m, dd] = cell.dataset.date.split('-').map(Number);
  const storage = getStorage();
  const task = storage.items.find(i => i.id === calDraggedId);
  if (task) {
    // 截止日期按当天结束处理，不保留具体时分
    task.dueDate = new Date(y, m - 1, dd, 23, 59, 59, 999).getTime();
    task.updatedAt = Date.now();
    saveStorage();
    renderTasks(searchInput.value);
  }
  calDraggedId = null;
  document.querySelectorAll('.cal-cell.cal-drop-over').forEach(c => c.classList.remove('cal-drop-over'));
}

function handleCalDragEnd() {
  document.querySelectorAll('.cal-chip.dragging').forEach(c => c.classList.remove('dragging'));
  document.querySelectorAll('.cal-cell.cal-drop-over').forEach(c => c.classList.remove('cal-drop-over'));
  calDraggedId = null;
}

// 点击日历格子空白处快速新建（截止该天）
function openAddForDate(dateKey: string) {
  const [y, m, dd] = dateKey.split('-').map(Number);
  currentQuadrant = 1;
  currentPriority = 'medium';
  updateQuadrantBtns(quadrantBtns, currentQuadrant);
  updatePriorityBtns(priorityBtns, currentPriority);
  showModal(addModal!);
  taskDue.value = `${y}-${String(m).padStart(2, '0')}-${String(dd).padStart(2, '0')}`;
  taskTitle.focus();
}

// 事件绑定
function initEvents() {
  document.querySelectorAll<HTMLButtonElement>('.todo-filter').forEach(btn => {
    btn.addEventListener('click', () => {
      activeQuadrant = Number(btn.dataset.filter);
      document.querySelectorAll('.todo-filter').forEach(el => {
        const active = Number((el as HTMLElement).dataset.filter) === activeQuadrant;
        el.classList.toggle('active', active);
        el.setAttribute('aria-pressed', String(active));
      });
      renderTasks();
    });
  });
  document.getElementById('listAddBtn')?.addEventListener('click', () => addTaskBtn?.click());
  document.querySelector('.todo-more-menu')?.addEventListener('click', () => { (document.querySelector('.todo-more') as HTMLDetailsElement).open = false; });
  // 搜索（带防抖）
  searchInput.addEventListener('input', () => {
    debounceSearch(() => renderTasks(searchInput.value));
  });

  // 清除搜索
  searchClearBtn?.addEventListener('click', () => {
    searchInput.value = '';
    renderTasks();
  });

  // 批量模式
  batchModeBtn?.addEventListener('click', toggleBatchMode);
  btnBatchComplete?.addEventListener('click', batchComplete);
  btnBatchDelete?.addEventListener('click', batchDelete);
  btnBatchCancel?.addEventListener('click', () => {
    batchModeActive = false;
    selectedTaskIds.clear();
    batchModeBtn?.classList.remove('active');
    batchActionsPanel?.classList.remove('show');
    renderTasks(searchInput.value);
  });

  // 清除已完成任务
  clearCompletedBtn?.addEventListener('click', clearCompletedTasks);

  // 添加任务按钮
  addTaskBtn?.addEventListener('click', () => { clearAddForm(); currentQuadrant = (activeQuadrant || 2) as 1 | 2 | 3 | 4; updateQuadrantBtns(quadrantBtns, currentQuadrant); showModal(addModal!); taskTitle.focus(); });
  modalClose?.addEventListener('click', () => hideModal(addModal!, true));
  btnCancel?.addEventListener('click', () => hideModal(addModal!, true));
  btnSubmit?.addEventListener('click', addTask);

  // 编辑弹窗
  editModalClose?.addEventListener('click', () => hideModal(editModal!));
  editBtnCancel?.addEventListener('click', () => hideModal(editModal!));
  editBtnSubmit?.addEventListener('click', saveEdit);
  btnDelete?.addEventListener('click', () => {
    if (editingTaskId) {
      hideModal(editModal!);
      openDeleteModal(editingTaskId);
    }
  });

  // 删除弹窗
  deleteModalClose?.addEventListener('click', () => hideModal(deleteModal!));
  deleteBtnCancel?.addEventListener('click', () => hideModal(deleteModal!));
  deleteBtnConfirm?.addEventListener('click', confirmDelete);

  // 象限选择
  quadrantBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      currentQuadrant = parseInt(btn.getAttribute('data-quadrant') || '1') as 1 | 2 | 3 | 4;
      updateQuadrantBtns(quadrantBtns, currentQuadrant);
    });
  });

  editQuadrantBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      currentQuadrant = parseInt(btn.getAttribute('data-quadrant') || '1') as 1 | 2 | 3 | 4;
      updateQuadrantBtns(editQuadrantBtns, currentQuadrant);
    });
  });

  // 优先级选择
  priorityBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      currentPriority = btn.getAttribute('data-priority') as 'high' | 'medium' | 'low';
      updatePriorityBtns(priorityBtns, currentPriority);
    });
  });

  editPriorityBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      currentPriority = btn.getAttribute('data-priority') as 'high' | 'medium' | 'low';
      updatePriorityBtns(editPriorityBtns, currentPriority);
    });
  });

  // 象限卡片添加按钮
  document.querySelectorAll('.quadrant-add-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      currentQuadrant = parseInt(btn.getAttribute('data-quadrant') || '1') as 1 | 2 | 3 | 4;
      updateQuadrantBtns(quadrantBtns, currentQuadrant);
      showModal(addModal!);
      taskTitle.focus();
    });
  });

  // 拖拽事件
  document.querySelectorAll<HTMLElement>('.quadrant-card').forEach(card => {
    card.addEventListener('dragover', handleDragOver);
    card.addEventListener('drop', handleDrop);
  });

  // 任务项事件（使用事件委托）
  document.querySelectorAll<HTMLElement>('.task-list').forEach(list => {
    list.addEventListener('click', (e: Event) => {
      const target = e.target as HTMLElement;

      // 点击批量选择复选框
      if (target.classList.contains('task-batch-checkbox')) {
        const taskId = target.dataset.id;
        if (taskId) toggleBatchSelection(taskId);
        return; // 批量模式下不触发其他操作
      }

      // 批量模式下点击任务项整行也触发选择
      if (batchModeActive && target.closest('.task-item')) {
        const taskId = (target.closest('.task-item') as HTMLElement).dataset.id;
        if (taskId) toggleBatchSelection(taskId);
        return;
      }

      // 点击复选框
      if (target.classList.contains('task-checkbox')) {
        const taskId = target.dataset.id;
        if (taskId) toggleComplete(taskId);
      }

      // 点击编辑按钮
      if (target.classList.contains('edit') || target.closest('.edit')) {
        const taskId = target.dataset.id || target.closest<HTMLElement>('.edit')?.dataset.id;
        if (taskId) openEditModal(taskId);
      }

      // 点击删除按钮
      if (target.classList.contains('delete') || target.closest('.delete')) {
        const taskId = target.dataset.id || target.closest<HTMLElement>('.delete')?.dataset.id;
        if (taskId) openDeleteModal(taskId);
      }

      // 点击任务标题查看详情
      if (target.classList.contains('task-title') || (target.closest('.task-item') && !target.closest('button,input,a'))) {
        const taskItem = target.closest<HTMLElement>('.task-item');
        const taskId = taskItem?.dataset.id;
        if (taskId && !batchModeActive) openDetailModal(taskId);
      }
    });

    list.addEventListener('dragstart', handleDragStart);
    list.addEventListener('dragend', handleDragEnd);
  });

  // 归档面板：折叠 + 列表事件委托
  document.getElementById('archiveToggle')?.addEventListener('click', toggleArchive);
  document.getElementById('archiveList')?.addEventListener('click', (e: Event) => {
    const target = e.target as HTMLElement;

    const restore = target.closest('.restore') as HTMLElement | null;
    if (restore?.dataset.id) { restoreTask(restore.dataset.id); return; }

    const del = target.closest('.delete') as HTMLElement | null;
    if (del?.dataset.id) { openDeleteModal(del.dataset.id); return; }

    if (target.classList.contains('archive-item-title')) {
      const item = target.closest('.archive-item') as HTMLElement | null;
      if (item?.dataset.id) openDetailModal(item.dataset.id);
    }
  });

  // 详情弹窗
  detailModalClose?.addEventListener('click', () => hideModal(detailModal!));
  detailBtnCancel?.addEventListener('click', () => hideModal(detailModal!));
  detailBtnEdit?.addEventListener('click', () => {
    if (viewingTaskId) {
      hideModal(detailModal!);
      openEditModal(viewingTaskId);
    }
  });

  // Undo
  undoBtn?.addEventListener('click', undoDelete);

  // 导出
  exportJsonBtn?.addEventListener('click', exportToJson);
  exportCsvBtn?.addEventListener('click', exportToCsv);

  // ESC 关闭弹窗
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      (document.querySelector('.todo-more') as HTMLDetailsElement).open = false;
      if (addModal?.classList.contains('show')) hideModal(addModal, true);
      if (editModal?.classList.contains('show')) hideModal(editModal);
      if (deleteModal?.classList.contains('show')) hideModal(deleteModal);
      if (detailModal?.classList.contains('show')) hideModal(detailModal);
    }
  });

  // Enter 提交
  taskTitle.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') addTask();
  });

  // ============ 日历视图事件 ============
  // 月份导航
  document.getElementById('prevMonthBtn')?.addEventListener('click', () => changeMonth(-1));
  document.getElementById('nextMonthBtn')?.addEventListener('click', () => changeMonth(1));
  document.getElementById('todayBtn')?.addEventListener('click', goToToday);

  // 日历格子点击：chip→详情，more→展开，空白→新建
  const calGrid = document.getElementById('calGrid');
  calGrid?.addEventListener('click', (e: Event) => {
    const target = e.target as HTMLElement;
    const more = target.closest('.cal-more') as HTMLElement | null;
    if (more && more.dataset.date) {
      expandedDays.add(more.dataset.date);
      renderCalendar(searchInput.value);
      return;
    }
    const chip = target.closest('.cal-chip') as HTMLElement | null;
    if (chip && chip.dataset.id) {
      openDetailModal(chip.dataset.id);
      return;
    }
    const cell = target.closest('.cal-cell') as HTMLElement | null;
    if (cell && cell.dataset.date) {
      subscription?.select(cell.dataset.date);
    }
  });

  calGrid?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const target = e.target as HTMLElement;
    if (target.classList.contains('cal-chip')) { e.preventDefault(); openDetailModal(target.dataset.id!); }
    else if (target.classList.contains('cal-cell')) { e.preventDefault(); subscription?.select(target.dataset.date!); }
  });
  // 拖拽改期（calGrid 与无日期区共用 handler）
  const calUnscheduled = document.getElementById('calUnscheduled');
  [calGrid, calUnscheduled].forEach(el => {
    el?.addEventListener('dragstart', handleCalDragStart);
    el?.addEventListener('dragover', handleCalDragOver);
    el?.addEventListener('drop', handleCalDrop);
    el?.addEventListener('dragend', handleCalDragEnd);
  });

  // 浏览器通知
  requestNotificationPermission();
  // 每30分钟检查截止日期通知
  setInterval(checkDeadlineNotifications, 30 * 60 * 1000);
}

