ound:var(--todo-accent);flex-shrink:0}.cal-chip-dot.high{background:#c36969}.cal-chip-dot.medium{background:#ac894d}.cal-chip-dot.low{background:#9ca3af}.cal-chip.completed{opacity:.35}.cal-chip-time,.cal-chip-title{display:none}.cal-more{font-size:.5rem;color:var(--todo-accent);cursor:pointer}.cal-drop-over{outline:2px dashed var(--todo-accent)}.cal-unscheduled{display:flex;flex-wrap:wrap;gap:5px;align-items:center;margin-top:10px}.cal-unscheduled-label{font-size:.6rem;color:var(--todo-muted)}.cal-unscheduled:empty{display:none}.todo-progress{margin-top:16px}.todo-progress h2{font-size:.8rem;font-weight:500;margin:0}.todo-progress p{font-size:.7rem;color:var(--todo-muted);margin:8px 0 0}.progress-track{height:4px;background:var(--todo-soft);border-radius:8px;overflow:hidden;margin-top:15px}#taskProgress{height:100%;background:var(--todo-accent);width:0}.todo-archive{margin-top:20px;border:1px solid var(--todo-line);border-radius:10px;overflow:hidden;background:var(--todo-bg)}.archive-header{display:flex;align-items:center;gap:8px;width:100%;padding:13px 16px;font-size:.8rem;color:var(--todo-muted)}.archive-arrow{margin-left:auto}.collapsed .archive-arrow{transform:rotate(-90deg)}.collapsed .archive-body{display:none}.archive-list{padding:0 16px}.archive-item{display:flex;align-items:center;gap:8px;padding:12px 0;border-top:1px solid var(--todo-line)}.archive-item-title{flex:1;min-width:0;font-size:.8rem;text-decoration:line-through;color:var(--todo-muted);cursor:pointer;overflow-wrap:anywhere}.archive-item-time{font-size:.6rem;color:var(--todo-muted)}.archive-item-actions{display:flex;gap:8px}.archive-action-btn{font-size:.7rem;color:var(--todo-muted)}.archive-empty{padding:20px;font-size:.75rem;color:var(--todo-muted)}.dragging{opacity:.5}.drag-placeholder{border:1px dashed var(--todo-accent);background:var(--todo-tint)}.completion-particles{display:none}
