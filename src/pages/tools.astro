---
// src/pages/tools.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="小工具" description="Token 估算、JSON/YAML、Markdown 预览、文本对比、正则测试">
  <div class="tools-page">
    <header class="tools-header">
      <h1>小工具</h1>
      <p class="tools-subtitle">Token 估算 · JSON/YAML · Markdown 预览 · 文本对比 · 正则测试</p>
    </header>

    <!-- Tab 导航栏 -->
    <nav class="tools-tabs" id="toolsTabs">
      <button class="tab-btn active" data-tab="token">Token 估算</button>
      <button class="tab-btn" data-tab="json">JSON / YAML</button>
      <button class="tab-btn" data-tab="markdown">Markdown 预览</button>
      <button class="tab-btn" data-tab="diff">文本对比</button>
      <button class="tab-btn" data-tab="regex">正则测试</button>
    </nav>

    <div class="tools-content">
      <!-- Token 估算 -->
      <div class="tool-panel active" id="panel-token">
        <div class="tool-section">
          <label class="tool-label" for="tokenInput">输入文本</label>
          <textarea class="tool-input" id="tokenInput" placeholder="粘贴 prompt 或任意文本，实时估算 token 数"></textarea>
          <div class="token-stats" id="tokenStats">
            <div class="token-stat"><span class="label">字符数</span><span class="value" id="statChars">0</span></div>
            <div class="token-stat"><span class="label">单词数</span><span class="value" id="statWords">0</span></div>
            <div class="token-stat"><span class="label">中日韩字符</span><span class="value" id="statCjk">0</span></div>
            <div class="token-stat token-stat-primary"><span class="label">估算 Token</span><span class="value" id="statTokens">0</span></div>
          </div>
          <p class="token-note">估算值，非精确分词；实际 token 数因模型分词器而异。</p>
          <div class="token-windows" id="tokenWindows"></div>
        </div>
      </div>

      <!-- JSON / YAML -->
      <div class="tool-panel" id="panel-json">
        <div class="tool-section">
          <label class="tool-label" for="jsonInput">输入 JSON 或 YAML</label>
          <textarea class="tool-input" id="jsonInput" placeholder={'{"name": "example", "value": 123}'}></textarea>
          <div class="tool-actions">
            <button class="tool-btn tool-btn-primary" data-action="formatJson">格式化 JSON</button>
            <button class="tool-btn tool-btn-secondary" data-action="minifyJson">压缩 JSON</button>
            <button class="tool-btn tool-btn-success" data-action="jsonToYaml">JSON → YAML</button>
            <button class="tool-btn tool-btn-success" data-action="yamlToJson">YAML → JSON</button>
            <button class="tool-btn tool-btn-secondary" data-action="copyJson">复制</button>
            <button class="tool-btn tool-btn-danger" data-action="clearJson">清空</button>
            <span class="json-status" id="jsonStatus"></span>
          </div>
          <label class="tool-label" for="jsonOutput">输出结果</label>
          <textarea class="tool-output" id="jsonOutput" readonly></textarea>
        </div>
      </div>

      <!-- Markdown 预览 -->
      <div class="tool-panel" id="panel-markdown">
        <div class="tool-section">
          <div class="md-split">
            <div class="md-pane">
              <div class="md-pane-head">
                <label class="tool-label" for="mdInput">Markdown 源</label>
                <div class="md-pane-actions">
                  <button class="tool-btn tool-btn-secondary" data-action="copyMdHtml">复制 HTML</button>
                  <button class="tool-btn tool-btn-danger" data-action="clearMd">清空</button>
                </div>
              </div>
              <textarea class="tool-input md-input" id="mdInput" placeholder="# 标题&#10;&#10;输入 Markdown，右侧实时预览"></textarea>
            </div>
            <div class="md-pane">
              <label class="tool-label">预览</label>
              <div class="md-preview prose dark:prose-invert max-w-none" id="mdPreview"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- 文本对比 -->
      <div class="tool-panel" id="panel-diff">
        <div class="tool-section">
          <label class="tool-label">文本对比</label>
          <div class="diff-inputs">
            <div class="input-group">
              <label class="tool-label">原始文本</label>
              <div class="diff-editor-container">
                <div class="diff-overlay" id="diffOverlayLeft"></div>
                <textarea class="tool-input diff-editor" id="diffInput1" placeholder="输入原始文本"></textarea>
              </div>
            </div>
            <div class="input-group">
              <label class="tool-label">新文本</label>
              <div class="diff-editor-container">
                <div class="diff-overlay" id="diffOverlayRight"></div>
                <textarea class="tool-input diff-editor" id="diffInput2" placeholder="输入新文本"></textarea>
              </div>
            </div>
          </div>
          <div class="tool-actions">
            <button class="tool-btn tool-btn-primary" data-action="compareDiff">对比</button>
            <button class="tool-btn tool-btn-danger" data-action="clearDiff">清空</button>
          </div>
          <div class="diff-stats" id="diffStats"></div>
        </div>
      </div>

      <!-- 正则测试 -->
      <div class="tool-panel" id="panel-regex">
        <div class="tool-section">
          <label class="tool-label" for="regexPattern">正则表达式</label>
          <div class="regex-pattern-row">
            <span class="regex-slash">/</span>
            <input type="text" id="regexPattern" class="regex-pattern" placeholder="\d{4}-\d{2}-\d{2}" spellcheck="false" />
            <span class="regex-slash">/</span>
            <div class="regex-flags">
              <label><input type="checkbox" data-flag="g" checked /> g</label>
              <label><input type="checkbox" data-flag="i" /> i</label>
              <label><input type="checkbox" data-flag="m" /> m</label>
              <label><input type="checkbox" data-flag="s" /> s</label>
            </div>
          </div>
          <span class="json-status" id="regexStatus"></span>
          <label class="tool-label" for="regexInput">测试文本</label>
          <textarea class="tool-input" id="regexInput" placeholder="输入待匹配的文本"></textarea>
          <label class="tool-label">匹配结果 <span class="regex-count" id="regexCount"></span></label>
          <div class="regex-result" id="regexResult"></div>
          <div class="regex-groups" id="regexGroups"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { marked } from 'marked';
    import * as yaml from 'js-yaml';

    // ---------- 通用工具 ----------
    function showToast(message: string, type: 'success' | 'error' = 'success') {
      document.querySelector('.toast')?.remove();
      const toast = document.createElement('div');
      toast.className = `toast toast-${type}`;
      toast.textContent = message;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 2000);
    }

    async function copyToClipboard(text: string) {
      if (!text) {
        showToast('无内容可复制', 'error');
        return;
      }
      try {
        await navigator.clipboard.writeText(text);
        showToast('已复制到剪贴板');
      } catch {
        showToast('复制失败', 'error');
      }
    }

    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function $(id: string) {
      return document.getElementById(id);
    }

    // ---------- Tab 切换 ----------
    let currentTab = 'token';
    const tabsContainer = $('toolsTabs')!;
    const validTabs = ['token', 'json', 'markdown', 'diff', 'regex'];

    function updateTabState() {
      tabsContainer.querySelectorAll('.tab-btn').forEach(btn => {
        const el = btn as HTMLElement;
        const active = el.dataset.tab === currentTab;
        el.classList.toggle('active', active);
        el.setAttribute('aria-selected', String(active));
      });
      document.querySelectorAll('.tool-panel').forEach(panel => {
        panel.classList.toggle('active', panel.id === `panel-${currentTab}`);
      });
    }

    function initTabs() {
      const hash = window.location.hash.slice(1);
      if (hash && validTabs.includes(hash)) currentTab = hash;
      updateTabState();

      tabsContainer.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const tab = (btn as HTMLElement).dataset.tab;
          if (tab && tab !== currentTab) {
            currentTab = tab;
            updateTabState();
            window.location.hash = tab;
          }
        });
      });

      window.addEventListener('hashchange', () => {
        const h = window.location.hash.slice(1);
        if (h && h !== currentTab && validTabs.includes(h)) {
          currentTab = h;
          updateTabState();
        }
      });

      // 键盘左右切换
      tabsContainer.addEventListener('keydown', (e: Event) => {
        const ke = e as KeyboardEvent;
        const tabs = Array.from(tabsContainer.querySelectorAll('.tab-btn'));
        const idx = tabs.findIndex(t => t === document.activeElement);
        if (idx === -1) return;
        if (ke.key === 'ArrowRight' && idx < tabs.length - 1) (tabs[idx + 1] as HTMLElement).focus();
        else if (ke.key === 'ArrowLeft' && idx > 0) (tabs[idx - 1] as HTMLElement).focus();
      });
    }

    // ---------- 事件绑定（data-action） ----------
    function bindActions() {
      const handlers: Record<string, () => void> = {
        formatJson, minifyJson, jsonToYaml, yamlToJson, copyJson, clearJson,
        copyMdHtml, clearMd,
        compareDiff, clearDiff,
      };
      document.querySelectorAll('[data-action]').forEach(el => {
        const action = (el as HTMLElement).dataset.action!;
        if (handlers[action]) el.addEventListener('click', handlers[action]);
      });
    }

    // ---------- Token 估算 ----------
    const CONTEXT_WINDOWS = [
      { label: '8K', size: 8192 },
      { label: '32K', size: 32768 },
      { label: '128K', size: 131072 },
      { label: '200K', size: 204800 },
    ];

    function countCjk(text: string): number {
      const m = text.match(/[一-鿿㐀-䶿぀-ヿ가-힯]/g);
      return m ? m.length : 0;
    }

    function estimateTokens(text: string, cjk: number): number {
      // 启发式：CJK 字符约 1.6 token/字，其余约 4 字符/token
      const nonCjk = text.length - cjk;
      return Math.ceil(cjk * 1.6 + Math.max(0, nonCjk) / 4);
    }

    function updateTokenStats() {
      const text = ($('tokenInput') as HTMLTextAreaElement).value;
      const chars = text.length;
      const words = text.trim() ? text.trim().split(/\s+/).length : 0;
      const cjk = countCjk(text);
      const tokens = estimateTokens(text, cjk);

      $('statChars')!.textContent = chars.toLocaleString();
      $('statWords')!.textContent = words.toLocaleString();
      $('statCjk')!.textContent = cjk.toLocaleString();
      $('statTokens')!.textContent = tokens.toLocaleString();

      const windowsEl = $('tokenWindows')!;
      windowsEl.innerHTML = '';
      CONTEXT_WINDOWS.forEach(w => {
        const pct = Math.min(100, (tokens / w.size) * 100);
        const row = document.createElement('div');
        row.className = 'token-window';
        const over = tokens > w.size;

        const head = document.createElement('div');
        head.className = 'token-window-head';
        const name = document.createElement('span');
        name.textContent = `${w.label} 上下文`;
        const ratio = document.createElement('span');
        ratio.className = over ? 'token-window-over' : '';
        ratio.textContent = `${pct.toFixed(pct < 1 ? 2 : 1)}%`;
        head.appendChild(name);
        head.appendChild(ratio);

        const bar = document.createElement('div');
        bar.className = 'token-window-bar';
        const fill = document.createElement('div');
        fill.className = `token-window-fill${over ? ' over' : ''}`;
        fill.style.width = `${pct}%`;
        bar.appendChild(fill);

        row.appendChild(head);
        row.appendChild(bar);
        windowsEl.appendChild(row);
      });
    }

    // ---------- JSON / YAML ----------
    function setJsonStatus(ok: boolean, text: string) {
      const status = $('jsonStatus')!;
      status.textContent = text;
      status.className = `json-status ${ok ? 'valid' : 'invalid'}`;
    }

    function formatJson() {
      const input = ($('jsonInput') as HTMLTextAreaElement).value;
      try {
        ($('jsonOutput') as HTMLTextAreaElement).value = JSON.stringify(JSON.parse(input), null, 2);
        setJsonStatus(true, '✓ 有效 JSON');
        showToast('格式化成功');
      } catch (e) {
        ($('jsonOutput') as HTMLTextAreaElement).value = '错误: ' + (e as Error).message;
        setJsonStatus(false, '✗ 无效 JSON');
        showToast('JSON 格式错误', 'error');
      }
    }

    function minifyJson() {
      const input = ($('jsonInput') as HTMLTextAreaElement).value;
      try {
        ($('jsonOutput') as HTMLTextAreaElement).value = JSON.stringify(JSON.parse(input));
        setJsonStatus(true, '✓ 有效 JSON');
        showToast('压缩成功');
      } catch (e) {
        ($('jsonOutput') as HTMLTextAreaElement).value = '错误: ' + (e as Error).message;
        setJsonStatus(false, '✗ 无效 JSON');
        showToast('JSON 格式错误', 'error');
      }
    }

    function jsonToYaml() {
      const input = ($('jsonInput') as HTMLTextAreaElement).value;
      try {
        ($('jsonOutput') as HTMLTextAreaElement).value = yaml.dump(JSON.parse(input), { indent: 2, lineWidth: -1 });
        setJsonStatus(true, '✓ JSON → YAML');
        showToast('转换成功');
      } catch (e) {
        ($('jsonOutput') as HTMLTextAreaElement).value = '错误: ' + (e as Error).message;
        setJsonStatus(false, '✗ 无效 JSON');
        showToast('JSON 解析失败', 'error');
      }
    }

    function yamlToJson() {
      const input = ($('jsonInput') as HTMLTextAreaElement).value;
      try {
        ($('jsonOutput') as HTMLTextAreaElement).value = JSON.stringify(yaml.load(input), null, 2);
        setJsonStatus(true, '✓ YAML → JSON');
        showToast('转换成功');
      } catch (e) {
        ($('jsonOutput') as HTMLTextAreaElement).value = '错误: ' + (e as Error).message;
        setJsonStatus(false, '✗ 无效 YAML');
        showToast('YAML 解析失败', 'error');
      }
    }

    function copyJson() {
      copyToClipboard(($('jsonOutput') as HTMLTextAreaElement).value);
    }

    function clearJson() {
      ($('jsonInput') as HTMLTextAreaElement).value = '';
      ($('jsonOutput') as HTMLTextAreaElement).value = '';
      $('jsonStatus')!.textContent = '';
      $('jsonStatus')!.className = 'json-status';
    }

    // ---------- Markdown 预览 ----------
    function renderMarkdown() {
      const src = ($('mdInput') as HTMLTextAreaElement).value;
      // 内容为用户本地输入、不存储不分享，渲染结果只影响自身浏览器，故直接 innerHTML。
      $('mdPreview')!.innerHTML = marked.parse(src) as string;
    }

    function copyMdHtml() {
      copyToClipboard($('mdPreview')!.innerHTML);
    }

    function clearMd() {
      ($('mdInput') as HTMLTextAreaElement).value = '';
      renderMarkdown();
    }

    // ---------- 文本对比（LCS 字符级差异） ----------
    function computeLCS(arr1: string[], arr2: string[]): string[] {
      const m = arr1.length, n = arr2.length;
      const dp: number[][] = Array(m + 1).fill(null).map(() => Array(n + 1).fill(0));
      for (let i = 1; i <= m; i++) {
        for (let j = 1; j <= n; j++) {
          dp[i][j] = arr1[i - 1] === arr2[j - 1]
            ? dp[i - 1][j - 1] + 1
            : Math.max(dp[i - 1][j], dp[i][j - 1]);
        }
      }
      const lcs: string[] = [];
      let i = m, j = n;
      while (i > 0 && j > 0) {
        if (arr1[i - 1] === arr2[j - 1]) { lcs.unshift(arr1[i - 1]); i--; j--; }
        else if (dp[i - 1][j] > dp[i][j - 1]) i--;
        else j--;
      }
      return lcs;
    }

    function computeCharDiff(str1: string, str2: string) {
      const chars1 = [...str1], chars2 = [...str2];
      const lcs = computeLCS(chars1, chars2);
      let leftResult = '', rightResult = '';
      let i1 = 0, lcsIdx = 0;
      while (i1 < chars1.length || lcsIdx < lcs.length) {
        if (lcsIdx < lcs.length && i1 < chars1.length && chars1[i1] === lcs[lcsIdx]) {
          leftResult += escapeHtml(chars1[i1]); i1++; lcsIdx++;
        } else if (i1 < chars1.length) {
          leftResult += `<span class="char-diff removed">${escapeHtml(chars1[i1])}</span>`; i1++;
        }
      }
      let i2 = 0; lcsIdx = 0;
      while (i2 < chars2.length || lcsIdx < lcs.length) {
        if (lcsIdx < lcs.length && i2 < chars2.length && chars2[i2] === lcs[lcsIdx]) {
          rightResult += escapeHtml(chars2[i2]); i2++; lcsIdx++;
        } else if (i2 < chars2.length) {
          rightResult += `<span class="char-diff added">${escapeHtml(chars2[i2])}</span>`; i2++;
        }
      }
      return { left: leftResult, right: rightResult };
    }

    function compareDiff() {
      const input1 = $('diffInput1') as HTMLTextAreaElement;
      const input2 = $('diffInput2') as HTMLTextAreaElement;
      const overlayLeft = $('diffOverlayLeft')!;
      const overlayRight = $('diffOverlayRight')!;
      const stats = $('diffStats')!;

      const text1 = input1.value, text2 = input2.value;
      if (!text1 && !text2) {
        showToast('请输入文本内容', 'error');
        return;
      }

      const lines1 = text1.split('\n'), lines2 = text2.split('\n');
      let added = 0, removed = 0, changed = 0;
      const maxLen = Math.max(lines1.length, lines2.length);
      let leftHtml = '', rightHtml = '';

      for (let i = 0; i < maxLen; i++) {
        const line1 = lines1[i] ?? '', line2 = lines2[i] ?? '';
        if (line1 === line2) {
          leftHtml += `<div class="diff-line-overlay same">${escapeHtml(line1) || '&nbsp;'}</div>`;
          rightHtml += `<div class="diff-line-overlay same">${escapeHtml(line2) || '&nbsp;'}</div>`;
        } else if (line1 && !line2) {
          leftHtml += `<div class="diff-line-overlay removed"><span class="char-diff removed">${escapeHtml(line1)}</span></div>`;
          rightHtml += `<div class="diff-line-overlay empty">&nbsp;</div>`;
          removed++;
        } else if (!line1 && line2) {
          leftHtml += `<div class="diff-line-overlay empty">&nbsp;</div>`;
          rightHtml += `<div class="diff-line-overlay added"><span class="char-diff added">${escapeHtml(line2)}</span></div>`;
          added++;
        } else {
          const charDiff = computeCharDiff(line1, line2);
          leftHtml += `<div class="diff-line-overlay modified">${charDiff.left || '&nbsp;'}</div>`;
          rightHtml += `<div class="diff-line-overlay modified">${charDiff.right || '&nbsp;'}</div>`;
          changed++;
        }
      }

      stats.innerHTML = `
        <span class="diff-stat added">+${added} 新增</span>
        <span class="diff-stat removed">-${removed} 删除</span>
        <span class="diff-stat changed">~${changed} 修改</span>
      `;
      overlayLeft.innerHTML = leftHtml;
      overlayRight.innerHTML = rightHtml;
      overlayLeft.classList.add('active');
      overlayRight.classList.add('active');
      input1.classList.add('diff-mode');
      input2.classList.add('diff-mode');
      showToast('对比完成');
    }

    function clearDiff() {
      const input1 = $('diffInput1') as HTMLTextAreaElement;
      const input2 = $('diffInput2') as HTMLTextAreaElement;
      input1.value = ''; input2.value = '';
      input1.classList.remove('diff-mode');
      input2.classList.remove('diff-mode');
      $('diffOverlayLeft')!.innerHTML = '';
      $('diffOverlayRight')!.innerHTML = '';
      $('diffOverlayLeft')!.classList.remove('active');
      $('diffOverlayRight')!.classList.remove('active');
      $('diffStats')!.innerHTML = '';
    }

    // 编辑时退出 diff 高亮模式，避免文字透明看不见
    function exitDiffMode(input: HTMLTextAreaElement, overlay: HTMLElement) {
      input.classList.remove('diff-mode');
      overlay.classList.remove('active');
    }

    // ---------- 正则测试 ----------
    function getFlags(): string {
      let flags = '';
      document.querySelectorAll('#panel-regex .regex-flags input').forEach(el => {
        const cb = el as HTMLInputElement;
        if (cb.checked) flags += cb.dataset.flag;
      });
      return flags;
    }

    function runRegex() {
      const pattern = ($('regexPattern') as HTMLInputElement).value;
      const text = ($('regexInput') as HTMLTextAreaElement).value;
      const status = $('regexStatus')!;
      const result = $('regexResult')!;
      const groupsEl = $('regexGroups')!;
      const countEl = $('regexCount')!;

      groupsEl.innerHTML = '';
      countEl.textContent = '';

      if (!pattern) {
        status.textContent = '';
        status.className = 'json-status';
        result.innerHTML = escapeHtml(text);
        return;
      }

      let re: RegExp;
      let flags = getFlags();
      if (!flags.includes('g')) flags += 'g'; // 高亮需全局匹配
      try {
        re = new RegExp(pattern, flags);
        status.textContent = '✓ 有效正则';
        status.className = 'json-status valid';
      } catch (e) {
        status.textContent = '✗ ' + (e as Error).message;
        status.className = 'json-status invalid';
        result.innerHTML = escapeHtml(text);
        return;
      }

      let html = '';
      let lastIndex = 0;
      let count = 0;
      const groupRows: string[] = [];
      let m: RegExpExecArray | null;

      while ((m = re.exec(text)) !== null) {
        count++;
        html += escapeHtml(text.slice(lastIndex, m.index));
        html += `<mark class="regex-match">${escapeHtml(m[0]) || '&nbsp;'}</mark>`;
        lastIndex = m.index + m[0].length;

        if (m.length > 1) {
          const caps = m.slice(1).map((g, i) => `<span class="rg-idx">$${i + 1}</span> ${g === undefined ? '<em>undefined</em>' : escapeHtml(g)}`);
          groupRows.push(`<div class="regex-group-row"><span class="rg-match">匹配 ${count}</span>${caps.join('')}</div>`);
        }
        if (m[0] === '') re.lastIndex++; // 防止空匹配死循环
      }
      html += escapeHtml(text.slice(lastIndex));
      result.innerHTML = html || '<span class="regex-empty">无内容</span>';
      countEl.textContent = count ? `${count} 处匹配` : '无匹配';

      if (groupRows.length) {
        groupsEl.innerHTML = `<div class="regex-groups-title">捕获组</div>${groupRows.join('')}`;
      }
    }

    // ---------- 初始化 ----------
    initTabs();
    bindActions();

    // Token 实时
    $('tokenInput')!.addEventListener('input', updateTokenStats);
    updateTokenStats();

    // Markdown 实时
    $('mdInput')!.addEventListener('input', renderMarkdown);
    renderMarkdown();

    // Diff 编辑即退出高亮
    const diffInput1 = $('diffInput1') as HTMLTextAreaElement;
    const diffInput2 = $('diffInput2') as HTMLTextAreaElement;
    diffInput1.addEventListener('input', () => exitDiffMode(diffInput1, $('diffOverlayLeft')!));
    diffInput2.addEventListener('input', () => exitDiffMode(diffInput2, $('diffOverlayRight')!));

    // 正则实时
    $('regexPattern')!.addEventListener('input', runRegex);
    $('regexInput')!.addEventListener('input', runRegex);
    document.querySelectorAll('#panel-regex .regex-flags input').forEach(el => {
      el.addEventListener('change', runRegex);
    });
  </script>
</BaseLayout>

<style is:inline>
  /* 基础页面样式 */
  .tools-page { padding: 1rem 0; }

  .tools-header { text-align: center; margin-bottom: 2rem; }
