---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import { sortPostsByDate } from '../lib/post-utils';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts', ({ data }) => !data.draft);
sortPostsByDate(posts);
const cloudConfigured = Boolean(import.meta.env.PUBLIC_SUPABASE_URL?.trim() && import.meta.env.PUBLIC_SUPABASE_ANON_KEY?.trim());
---

<BaseLayout>
  <h1 class="text-2xl lg:text-3xl font-bold mb-8">最新文章</h1>

  <section id="home-feed" aria-label="文章列表">
  <script is:inline define:vars={{ cloudConfigured }}>
    if (cloudConfigured) {
      const feed = document.getElementById('home-feed');
      feed.setAttribute('data-loading', '');
      feed.setAttribute('aria-busy', 'true');
    }
  </script>
  <div id="home-feed-loading" role="status" aria-label="正在加载文章" class="space-y-6">
    <span class="sr-only">正在加载文章…</span>
    {[1, 2, 3].map(() => (
      <div aria-hidden="true" class="border-b border-gray-200 dark:border-gray-800 pb-6 motion-safe:animate-pulse">
        <div class="h-4 w-32 rounded bg-gray-200 dark:bg-gray-800"></div>
        <div class="h-6 w-3/4 mt-3 rounded bg-gray-200 dark:bg-gray-800"></div>
        <div class="h-4 w-full mt-3 rounded bg-gray-100 dark:bg-gray-800"></div>
        <div class="h-4 w-2/3 mt-2 rounded bg-gray-100 dark:bg-gray-800"></div>
      </div>
    ))}
  </div>
  <p id="cloud-feed-status" role="status" class="text-sm text-gray-500 empty:hidden mb-4"></p>
  <button id="home-feed-retry" type="button" hidden class="text-sm text-blue-600 dark:text-blue-400 hover:underline mb-4">重试加载</button>
  <p id="home-empty" class="text-gray-500" hidden={posts.length > 0}>还没有文章，快去写一篇吧！</p>
    <ul id="home-posts" class="space-y-6">
      {posts.map((post) => (
        <li data-date={post.data.date.toISOString()}>
          <article class="border-b border-gray-200 dark:border-gray-800 pb-6">
            <div class="flex items-center gap-3 text-sm text-gray-500 flex-wrap">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('zh-CN', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
              {post.data.category && (
                <a
                  href={`/categories/${post.data.category}/`}
                  class="px-2 py-0.5 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded text-xs hover:bg-blue-100 dark:hover:bg-blue-900/50 transition-colors"
                >
                  {post.data.category}
                </a>
              )}
              {post.data.category && post.data.subcategory && (
                <a
                  href={`/categories/${post.data.category}/${post.data.subcategory}/`}
                  class="px-2 py-0.5 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 rounded text-xs hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
                >
                  {post.data.subcategory}
                </a>
              )}
            </div>
            <h2 class="text-xl font-semibold mt-2">
              <a href={`/posts/${post.id}/`} class="hover:text-blue-600 dark:hover:text-blue-400">
                {post.data.title}
              </a>
            </h2>
            {post.data.description && (
              <p class="text-gray-600 dark:text-gray-400 mt-2">
                {post.data.description}
              </p>
            )}
            {post.data.tags && (
              <div class="flex flex-wrap gap-2 mt-3">
                {post.data.tags.map((tag) => (
                  <a
                    href={`/tags/${tag}/`}
                    class="max-w-full break-words [overflow-wrap:anywhere] px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-sm hover:bg-gray-200 dark:hover:bg-gray-700"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            )}
          </article>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
<style>
  #home-feed-loading { display: none; }
  #home-feed[data-loading] #home-feed-loading { display: block; }
  #home-feed[data-loading] :is(#home-posts, #home-empty) { display: none; }
</style>
<script>
import '../lib/home-articles';
</script>
