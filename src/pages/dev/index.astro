---
// 开发预览入口页面 - 直接跳转到第一篇文章
import { getCollection } from 'astro:content';
import { sortPostsByDate } from '../../lib/post-utils';
import BaseLayout from '../../layouts/BaseLayout.astro';

if (!import.meta.env.DEV) {
  return Astro.redirect('/');
}

const allPosts = await getCollection('posts');
sortPostsByDate(allPosts);

const firstPost = allPosts[0];
const firstPostSlug = firstPost?.id.replace('.md', '');
---

<BaseLayout title="开发预览" fullWidth hideHeader>
  {!firstPost && (
    <div class="dev-empty">
      <div class="dev-empty-card">
        <div class="dev-empty-icon">
          <svg width="48" height="48" viewBox="0 0 16 16" fill="currentColor"><path d="M10.57 1.14L13.85 4.43L14 5V14L13 15H3L2 14V2L3 1H10L10.57 1.14ZM10 5H13L10 2V5ZM3 2V14H13V6H9.5L9 5.5V2H3Z"/></svg>
        </div>
        <p class="dev-empty-text">还没有文章</p>
        <p class="dev-empty-hint">创建第一篇文章开始写作</p>
        <form id="new-post-form" class="dev-empty-form">
          <input
            type="text"
            name="title"
            placeholder="输入文章标题..."
            class="dev-empty-input"
            required
          />
          <button type="submit" class="dev-empty-btn">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M7.5 1H8.5V7.5H15V8.5H8.5V15H7.5V8.5H1V7.5H7.5V1Z"/></svg>
            新建文章
          </button>
        </form>
      </div>
    </div>
  )}

  {firstPost && (
    <script define:vars={{ firstPostSlug }}>
      window.location.href = `/dev/${firstPostSlug}/`;
    </script>
  )}

  <style>
    .dev-empty {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #1e1e1e;
    }
    .dev-empty-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      padding: 48px;
      background: #252526;
      border: 1px solid #333;
      border-radius: 8px;
    }
    .dev-empty-icon { color: #569cd6; opacity: 0.6; }
    .dev-empty-text {
      font-size: 16px;
      color: #cccccc;
      font-weight: 500;
      margin: 0;
    }
    .dev-empty-hint {
      font-size: 13px;
      color: #888;
      margin: 0;
    }
    .dev-empty-form {
      display: flex;
      gap: 8px;
      margin-top: 16px;
      width: 100%;
    }
    .dev-empty-input {
      flex: 1;
      padding: 8px 12px;
      background: #3c3c3c;
      border: 1px solid #555;
      border-radius: 4px;
      color: #cccccc;
      font-size: 13px;
      outline: none;
    }
    .dev-empty-input:focus { border-color: #569cd6; }
    .dev-empty-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: #2ea043;
      color: #fff;
      border: none;
      border-radius: 4px;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      white-space: nowrap;
    }
    .dev-empty-btn:hover { opacity: 0.9; }
  </style>

  <script>
    document.getElementById('new-post-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const title = (form.querySelector('input[name="title"]') as HTMLInputElement).value.trim();
      if (!title) return;

      const button = form.querySelector('button') as HTMLButtonElement;
      button.textContent = '创建中...';
      button.disabled = true;

      try {
        const res = await fetch('/api/create-post', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title })
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert('创建失败: ' + data.error);
          button.textContent = '新建文章';
          button.disabled = false;
        }
      } catch {
        alert('请求失败，请确保开发服务器正在运行');
        button.textContent = '新建文章';
        button.disabled = false;
      }
    });
  </script>
</BaseLayout>
