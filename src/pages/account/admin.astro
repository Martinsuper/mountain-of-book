---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountShell from '../../components/AccountShell.astro';
import ConfirmDialog from '../../components/ConfirmDialog.astro';
---
<BaseLayout title="文章管理"><div class="studio"><AccountShell title="文章管理">
  <button slot="actions" id="new-article" class="primary" aria-label="新建文章" hidden>＋ 新建文章</button>
  <div id="admin-panel" hidden>
    <div class="studio-grid">
      <section id="article-library" class="library" aria-label="文章库">
        <div class="library-toolbar">
          <div class="filters" role="group" aria-label="文章状态筛选"><button type="button" data-filter="all" aria-label="全部" aria-pressed="true">全部 <span id="count-all">0</span></button><button type="button" data-filter="draft" aria-label="草稿" aria-pressed="false">草稿 <span id="count-draft">0</span></button><button type="button" data-filter="published" aria-label="已发布" aria-pressed="false">已发布 <span id="count-published">0</span></button></div>
          <label class="search-label"><span class="sr-only">搜索文章</span><input id="article-search" type="search" placeholder="搜索文章标题…" /></label>
        </div>
        <div class="library-heading"><h2>在线文章</h2><span id="list-count" class="muted"></span></div>
        <ul id="admin-articles"></ul><p id="list-empty" class="empty" hidden>还没有文章。<br />从一篇新的草稿开始吧。</p>
        <p class="library-note">此处管理在线编辑的文章，仓库 Markdown 文章仍沿用原发布流程。</p>
      </section>
      <div id="writing-view" class="writing-column" hidden>
        <div class="editor-top"><button id="back-to-list" type="button">← 返回文章列表</button><span id="save-state" role="status">尚未保存</span></div>
        <div id="draft-recovery" role="status" hidden><span>发现此文章的本机未保存草稿。</span><button id="restore-draft" type="button">恢复草稿</button><button id="discard-draft" type="button">丢弃草稿</button></div>
        <form id="article-editor" class="card editor-card" novalidate>
          <label class="title-label"><span class="sr-only">标题</span><textarea name="title" rows="1" required maxlength="200" placeholder="给这篇文章起个标题"></textarea></label>
          <div class="metadata"><label>可见范围<select name="visibility"><option value="authenticated">登录可见</option><option value="public">公开</option></select></label><input name="status" type="hidden" value="draft" /><span id="article-status" class="muted">草稿</span></div>
          <div class="editor-toolbar"><div class="format-tools" role="group" aria-label="Markdown 格式"><button type="button" data-format="heading" title="插入二级标题" aria-label="插入二级标题">H₂</button><button type="button" data-format="bold" title="加粗" aria-label="加粗"><b>B</b></button><button type="button" data-format="italic" title="斜体" aria-label="斜体"><i>I</i></button><button type="button" data-format="list" title="插入列表" aria-label="插入列表">≡</button><button type="button" data-format="code" title="插入代码块" aria-label="插入代码块">&lt;/&gt;</button></div><div class="view-tools" role="group" aria-label="编辑视图"><button type="button" data-view="write" aria-pressed="true">编辑</button><button type="button" data-view="split" aria-pressed="false">分栏</button><button type="button" data-view="preview" aria-pressed="false">预览</button><button type="button" id="fullscreen-editor" title="全屏写作（Esc 退出）" aria-label="全屏写作" aria-pressed="false">全屏</button></div></div>
          <div class="editor-canvas" data-view="write"><label class="body-label"><span class="sr-only">Markdown 正文</span><textarea name="body" rows="20" required maxlength="200000" placeholder="从这里开始写作…&#10;&#10;支持 Markdown 标题、列表、引用与代码块。"></textarea></label><section id="markdown-preview" aria-label="Markdown 预览" hidden><div id="preview-content" class="prose dark:prose-invert max-w-none"></div></section></div>
          <div class="editor-bottom"><span id="word-count">0 字 · 约 1 分钟阅读</span><span>Markdown <span class="keyboard-hint">· ⌘ / Ctrl + S 保存</span></span></div>
          <p class="editor-notice" id="visibility-notice">发布后登录用户可在首页查看并阅读。未登录访客看不到标题和正文。草稿仅站长可见。</p>
          <div class="editor-actions">
            <div class="editor-auxiliary">
              <details id="article-more" class="article-more" hidden>
                <summary aria-controls="article-more-panel">更多操作</summary>
                <div id="article-more-panel" class="article-more-panel">
                  <button id="unpublish-article" type="button">取消发布</button>
                  <button id="delete-article" type="button">删除文章</button>
                  <p class="muted">删除会永久移除正文及授权，无法撤销。</p>
                </div>
              </details>
              <a id="view-article" hidden target="_blank" rel="noopener">查看文章 ↗</a>
            </div>
            <span id="save-feedback" role="status" aria-live="polite"></span>
            <div class="save-group"><button id="save-article" type="submit">保存草稿</button><button id="publish-article" class="primary" type="submit" value="published">发布文章</button></div>
          </div>
        </form>
        <details id="grant-panel" class="access-card" hidden><summary>历史文章阅读授权</summary>
          <div class="section-heading"><h2>阅读授权</h2><span class="muted">按账号授权</span></div>
          <p class="muted">为指定账号开放阅读权限。邮箱需先在 Supabase 中受邀；草稿不会向读者开放。</p>
          <form id="grant-form"><label>授权邮箱<input name="email" type="email" placeholder="reader@example.com" required /></label><button type="submit">授权此账号</button></form>
          <ul id="article-grants"></ul><p id="grants-empty" class="muted" hidden>暂未单独授权任何账号。</p>
        </details>
      </div>
    </div>
  </div>
</AccountShell></div><ConfirmDialog /></BaseLayout>
<script>
import { supabase, configurationMessage } from '../../lib/supabase';
const confirmDialog = (window as unknown as { confirmDialog: (o: { title?: string; message: string; confirmText?: string; cancelText?: string; variant?: 'danger' | 'info' }) => Promise<boolean> }).confirmDialog;
const status = document.getElementById('account-status')!;
const panel = document.getElementById('admin-panel')!;
const newArticle = document.getElementById('new-article') as HTMLButtonElement;
function setPanelVisible(visible: boolean) { panel.hidden = !visible; newArticle.hidden = !visible; }
const list = document.getElementById('admin-articles')!;
const grants = document.getElementById('article-grants')!;
const grantPanel = document.getElementById('grant-panel')!;
const editor = document.getElementById('article-editor') as HTMLFormElement;
const grantForm = document.getElementById('grant-form') as HTMLFormElement;
const bodyInput = editor.elements.namedItem('body') as HTMLTextAreaElement;
const titleInput = editor.elements.namedItem('title') as HTMLTextAreaElement;
const canvas = document.querySelector<HTMLElement>('.editor-canvas')!;
// Fullscreen is independent of the mutually exclusive writing views.
const fullscreenButton = document.getElementById('fullscreen-editor')!;
fullscreenButton.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="fullscreen-expand" d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/><path class="fullscreen-collapse" d="M3 8h5V3m13 5h-5V3M8 21v-5H3m13 5v-5h5"/></svg><span>全屏</span>';
const workspaceTools = document.createElement('div'); workspaceTools.className = 'workspace-tools';
const viewTools = document.querySelector('.view-tools')!;
viewTools.parentElement!.append(workspaceTools); workspaceTools.append(viewTools, fullscreenButton);
const articleMore = document.getElementById('article-more') as HTMLDetailsElement;
/** Close secondary actions without moving the writing canvas or save buttons. */
function closeMoreActions(restoreFocus = false) { articleMore.open = false; if (restoreFocus) articleMore.querySelector('summary')!.focus(); }
document.addEventListener('click', event => { if (!articleMore.contains(event.target as Node)) closeMoreActions(); });
document.addEventListener('keydown', event => { if (event.key === 'Escape' && articleMore.open) { event.preventDefault(); closeMoreActions(true); } });
articleMore.querySelectorAll('button').forEach(button => button.addEventListener('click', () => closeMoreActions(true)));
// Extend the compact toolbar without changing the existing accessible controls.
for (const [format, label, icon] of [['link', '插入链接', '↗'], ['quote', '插入引用', '❝'], ['ordered', '插入有序列表', '1.']]) {
  const button = document.createElement('button'); button.type = 'button'; button.dataset.format = format; button.title = label; button.setAttribute('aria-label', label); button.textContent = icon;
  document.querySelector('.format-tools')!.append(button);
}
const saveState = document.getElementById('save-state')!;
const library = document.getElementById('article-library')!;
const writing = document.getElementById('writing-view')!;
const studioRoot = document.querySelector('.studio')!;
let editing = false;
function showEditor(open: boolean) {
  closeMoreActions();
  editing = open; library.hidden = open; writing.hidden = !open;
  newArticle.hidden = panel.hidden || open;
  studioRoot.classList.toggle('editor-open', open);
  if (open) requestAnimationFrame(updateWritingHeight);
  const doc = document as Document & { webkitFullscreenElement?: Element | null; webkitExitFullscreen?: () => Promise<void> | void };
  if (!open && (doc.fullscreenElement ?? doc.webkitFullscreenElement)) void (doc.exitFullscreen ?? doc.webkitExitFullscreen)!.call(doc);
}
/** Size the writing workspace from its actual position, not a fixed header estimate. */
function updateWritingHeight() {
  if (writing.hidden) return;
  writing.style.setProperty('--writing-top', `${Math.max(0, writing.getBoundingClientRect().top)}px`);
}
window.addEventListener('resize', updateWritingHeight);
for (const event of ['fullscreenchange', 'webkitfullscreenchange']) document.addEventListener(event, () => requestAnimationFrame(updateWritingHeight));
new ResizeObserver(() => requestAnimationFrame(updateWritingHeight)).observe(document.querySelector('body > header') ?? document.body);
function updateActions() {
  const published = (editor.elements.namedItem('status') as HTMLInputElement).value === 'published';
  document.getElementById('save-article')!.textContent = published ? '保存修改' : '保存草稿';
  document.getElementById('publish-article')!.hidden = published;
  document.getElementById('article-status')!.textContent = published ? '已发布' : '草稿';
  document.getElementById('article-more')!.hidden = !selected;
  document.getElementById('unpublish-article')!.hidden = !published;
  const view = document.getElementById('view-article') as HTMLAnchorElement;
  view.hidden = !selected; view.href = selected ? `/posts/read/?id=${selected}` : '#';
}
type Article = { id: string; title: string; body: string; visibility: string; status: string; updated_at: string };
let articles: Article[] = [];
let selected: string | null = null;
let version: string | null = null;
let generation = 0;
let busy = false;
let activeUser: string | null = null;
let dirty = false;
let filter = 'all';
let previewTimer: ReturnType<typeof setTimeout>;
const recovery = document.getElementById('draft-recovery')!;
/** Mirror save state visually without relying on color alone. */
function updateSaveAppearance() {
  const text = saveState.textContent || '';
  const state = /失败|未完成/.test(text) ? 'error' : /保存中/.test(text) ? 'saving' : /未保存/.test(text) ? 'unsaved' : 'saved';
  saveState.dataset.state = state;
  document.getElementById('save-feedback')!.dataset.state = state;
}
new MutationObserver(updateSaveAppearance).observe(saveState, { childList: true, characterData: true, subtree: true });
updateSaveAppearance();
let pendingDraft: { title: string; body: string; visibility: string } | null = null;
/** Keep private recovery drafts scoped to the current account and article. */
function draftKey() { return activeUser ? `article-draft:${activeUser}:${selected ?? 'new'}` : null; }
function removeDraft() { const key = draftKey(); if (key) { try { localStorage.removeItem(key); } catch { /* Storage may be unavailable. */ } } recovery.hidden = true; pendingDraft = null; }
function persistDraft() {
  const key = draftKey(); if (!key || !dirty) return;
  try { localStorage.setItem(key, JSON.stringify({ title: titleInput.value, body: bodyInput.value, visibility: (editor.elements.namedItem('visibility') as HTMLSelectElement).value })); }
  catch { document.getElementById('save-feedback')!.textContent = '本机草稿备份不可用，请及时保存到云端。'; }
}
function checkDraft() {
  pendingDraft = null; recovery.hidden = true;
  try { const key = draftKey(); const raw = key && localStorage.getItem(key); if (!raw) return; const draft = JSON.parse(raw);
    if (typeof draft.title !== 'string' || typeof draft.body !== 'string' || !['public','authenticated','restricted'].includes(draft.visibility)) return;
    if (draft.title === titleInput.value && draft.body === bodyInput.value && draft.visibility === (editor.elements.namedItem('visibility') as HTMLSelectElement).value) { removeDraft(); return; }
    pendingDraft = draft; recovery.hidden = false;
  } catch { /* Ignore malformed or inaccessible local drafts. */ }
}
/** Fit the entire title, including borders, without an internal scroll area. */
function resizeTitle() {
  if (writing.hidden) return;
  titleInput.style.height = 'auto';
  const style = getComputedStyle(titleInput);
  titleInput.style.height = `${Math.ceil(titleInput.scrollHeight + parseFloat(style.borderTopWidth) + parseFloat(style.borderBottomWidth))}px`;
}
let titleWidth = 0;
new ResizeObserver(([entry]) => {
  if (entry.contentRect.width === titleWidth) return;
  titleWidth = entry.contentRect.width; resizeTitle();
}).observe(titleInput);
void document.fonts.ready.then(resizeTitle);
function setView(view: string) {
  if (view === 'split' && matchMedia('(max-width:767px)').matches) view = 'write';
  canvas.dataset.view = view;
  document.getElementById('markdown-preview')!.hidden = view === 'write';
  document.querySelectorAll<HTMLButtonElement>('button[data-view]').forEach(tab => tab.setAttribute('aria-pressed', String(tab.dataset.view === view)));
  document.querySelectorAll<HTMLButtonElement>('[data-format]').forEach(button => button.disabled = view === 'preview');
  updatePreview();
}
document.getElementById('restore-draft')!.onclick = () => {
  if (!pendingDraft || busy) return;
  titleInput.value = pendingDraft.title; bodyInput.value = pendingDraft.body;
  const visibility = editor.elements.namedItem('visibility') as HTMLSelectElement;
  if ([...visibility.options].some(option => option.value === pendingDraft!.visibility)) visibility.value = pendingDraft.visibility;
  recovery.hidden = true; pendingDraft = null; editor.dispatchEvent(new Event('input', { bubbles: true })); resizeTitle(); updatePreview();
};
document.getElementById('discard-draft')!.onclick = removeDraft;
matchMedia('(max-width:767px)').addEventListener('change', event => { if (event.matches && canvas.dataset.view === 'split') setView('write'); });
window.addEventListener('resize', resizeTitle);
// Preview is optional: a failed/stale Vite dependency must not prevent auth or editing.
let previewModules: Promise<[typeof import('marked'), typeof import('dompurify')]> | undefined;
let previewSequence = 0;
async function renderPreview(text: string, sequence: number) {
  const preview = document.getElementById('preview-content')!;
  try {
    previewModules ??= Promise.all([import('marked'), import('dompurify')]);
    const [{ marked }, { default: DOMPurify }] = await previewModules;
    if (sequence !== previewSequence) return;
    preview.innerHTML = DOMPurify.sanitize(marked.parse(text, { async: false }), { ALLOWED_TAGS: ['p','br','h2','h3','h4','h5','h6','ul','ol','li','strong','em','del','blockquote','pre','code','hr','table','thead','tbody','tr','th','td','a'], ALLOWED_ATTR: ['href','title'], ALLOW_DATA_ATTR: false });
    preview.querySelectorAll('a').forEach(link => { const href = link.getAttribute('href') || ''; if (!/^(https?:\/\/|mailto:|\/(?!\/)|#)/i.test(href)) link.removeAttribute('href'); link.rel = 'noreferrer noopener'; });
  } catch {
    previewModules = undefined;
    if (sequence !== previewSequence) return;
    preview.textContent = '预览组件加载失败，请刷新页面后重试。正文仍可编辑和保存。';
  }
}
function updatePreview() {
  const text = bodyInput.value;
  const sequence = ++previewSequence;
  document.getElementById('preview-content')!.replaceChildren();
  if (canvas.dataset.view !== 'write') void renderPreview(text, sequence);
  const readable = text.replace(/```[\s\S]*?```/g, '').replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/<[^>]*>/g, '').replace(/[#*~`>_|-]/g, '');
  const words = (readable.match(/\p{Script=Han}|[\p{L}\p{N}]+/gu) || []).length;
  document.getElementById('word-count')!.textContent = `${words.toLocaleString()} 阅读字数 · 约 ${Math.max(1, Math.ceil(words / 400))} 分钟阅读`;
  const visibility = (editor.elements.namedItem('visibility') as HTMLSelectElement).value;
  document.getElementById('visibility-notice')!.textContent = visibility === 'restricted' ? '历史指定账号文章：保留原授权范围，草稿仅站长可见。' : visibility === 'public' ? '发布后任何访客均可在首页查看并阅读。草稿仅站长可见。' : '发布后登录用户可在首页查看并阅读。未登录访客看不到标题和正文。草稿仅站长可见。';
}
async function mayLeave() { if (!dirty) return true; const leave = await confirmDialog({ title: '放弃未保存的修改', message: '有尚未保存的修改，确定放弃吗？', confirmText: '放弃修改' }); if (leave) removeDraft(); return leave; }
function resetEditor() {
  selected = null; version = null; dirty = false; editor.querySelector('option[value="restricted"]')?.remove(); editor.reset(); (editor.elements.namedItem('status') as HTMLInputElement).value = 'draft'; grantPanel.hidden = true; grants.replaceChildren();
  saveState.textContent = '尚未保存'; document.getElementById('save-feedback')!.textContent = ''; recovery.hidden = true; pendingDraft = null; canvas.dataset.view = 'write';
  document.getElementById('markdown-preview')!.hidden = true;
  document.querySelectorAll('button[data-view]').forEach(tab => tab.setAttribute('aria-pressed', String((tab as HTMLElement).dataset.view === 'write')));
  updateActions(); setView('write'); resizeTitle(); renderList();
}
async function selectArticle(row: Article) {
  if (busy || !(await mayLeave())) return;
  selected = row.id; version = row.updated_at; dirty = false;
  const visibility = editor.elements.namedItem('visibility') as HTMLSelectElement;
  visibility.querySelector('option[value="restricted"]')?.remove();
  if (row.visibility === 'restricted') visibility.add(new Option('指定账号可见（历史文章）', 'restricted'));
  for (const field of ['title','body','visibility','status'] as const) (editor.elements.namedItem(field) as HTMLInputElement).value = row[field];
  showEditor(true); updateActions(); saveState.textContent = '已保存至云端'; resizeTitle(); checkDraft();
  grantPanel.hidden = row.visibility !== 'restricted'; grantForm.hidden = row.visibility !== 'restricted'; updatePreview(); renderList();
  if (row.visibility === 'restricted') void loadGrants(row.id); else grants.replaceChildren();
  if (matchMedia('(max-width: 900px)').matches) editor.scrollIntoView({ block: 'start', behavior: 'smooth' });
}
function renderList() {
  list.replaceChildren(); const query = (document.getElementById('article-search') as HTMLInputElement).value.trim().toLowerCase();
  const visible = articles.filter(row => (filter === 'all' || row.status === filter) && row.title.toLowerCase().includes(query));
  for (const row of visible) {
    const item = document.createElement('li'); item.classList.toggle('selected', row.id === selected);
    const title = document.createElement('button'); title.className = 'article-title'; title.type = 'button'; title.textContent = row.title; title.onclick = () => selectArticle(row);
    const meta = document.createElement('div'); meta.className = 'article-meta';
    const badge = document.createElement('span'); badge.className = row.status === 'draft' ? 'badge draft' : 'badge published'; badge.textContent = row.status === 'draft' ? '草稿' : '已发布';
    const scope = document.createElement('span'); scope.textContent = row.visibility === 'restricted' ? '指定账号' : row.visibility === 'public' ? '公开' : '登录可见'; meta.append(badge, scope);
    const actions = document.createElement('div'); actions.className = 'article-actions';
    const edit = document.createElement('button'); edit.type = 'button'; edit.textContent = '编辑'; edit.setAttribute('aria-current', String(row.id === selected)); edit.onclick = () => selectArticle(row);
    const read = document.createElement('a'); read.textContent = row.status === 'draft' ? '预览草稿 ↗' : '阅读 ↗'; read.href = `/posts/read/?id=${row.id}`;
    const del = document.createElement('button'); del.type = 'button'; del.textContent = '删除'; del.className = 'delete'; del.onclick = async () => {
      if (busy || !(await confirmDialog({ title: '删除文章', message: `永久删除《${row.title}》及其授权，此操作无法撤销。`, confirmText: '永久删除' }))) return;
      void run(async () => {
        const { error } = await supabase!.from('articles').delete().eq('id', row.id);
        if (error) throw error;
        if (selected === row.id) { dirty = false; resetEditor(); showEditor(false); }
        await load();
      });
    };
    const date = document.createElement('time'); date.className = 'updated-date'; date.dateTime = row.updated_at; date.textContent = new Date(row.updated_at).toLocaleDateString('zh-CN');
    actions.append(edit, read, del); item.append(title, meta, date, actions); list.append(item);
  }
  document.getElementById('list-count')!.textContent = `${visible.length} 篇`;
  const empty = document.getElementById('list-empty')!; empty.hidden = visible.length > 0; empty.textContent = articles.length ? '没有符合条件的文章，试试其他关键词。' : '还没有文章，从一篇新的草稿开始吧。';
  for (const state of ['all','published','draft']) document.getElementById(`count-${state}`)!.textContent = String(state === 'all' ? articles.length : articles.filter(row => row.status === state).length);
}
async function load() {
  const current = ++generation; setPanelVisible(false); showEditor(false); status.hidden = false; articles = []; list.replaceChildren(); resetEditor();
  if (!supabase) { status.textContent = configurationMessage; return; }
  const { data: { user } } = await supabase.auth.getUser(); if (current !== generation) return;
  if (!user) { status.textContent = '请先到个人中心登录。'; return; }
  activeUser = user.id;
  const { data: admin, error } = await supabase.rpc('is_site_admin'); if (current !== generation) return;
  if (error || !admin) { status.textContent = error ? '无法验证管理权限，请检查配置。' : '当前账号没有管理权限。'; return; }
  const result = await supabase.from('articles').select('id,title,body,visibility,status,updated_at').order('created_at', { ascending: false });
  if (current !== generation) return;
  if (result.error) { status.textContent = '文章加载失败，请重试。'; return; }
  articles = result.data; renderList(); setPanelVisible(true); status.textContent = '已验证站长权限。'; status.hidden = true;
}
async function loadGrants(id: string) {
  grants.replaceChildren(); document.getElementById('grants-empty')!.hidden = true; const current = generation;
  const { data, error } = await supabase!.from('article_grants').select('user_id').eq('article_id', id);
  if (selected !== id || current !== generation) return;
  if (error) { status.hidden = false; status.textContent = '授权列表加载失败。'; return; }
  document.getElementById('grants-empty')!.hidden = data.length > 0;
  data.forEach(row => {
    const item = document.createElement('li'); const identity = document.createElement('span'); identity.textContent = `账号 ID：${row.user_id}`; item.append(identity);
    const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = '撤销授权';
    remove.onclick = () => run(async () => { const result = await supabase!.from('article_grants').delete().eq('article_id', id).eq('user_id', row.user_id); if (result.error) throw result.error; await loadGrants(id); });
    item.append(remove); grants.append(item);
  });
}
async function run(action: () => Promise<void>) {
  if (busy) return; busy = true; newArticle.disabled = true;
  const focused = document.activeElement as HTMLElement | null;
  const selection = [bodyInput.selectionStart, bodyInput.selectionEnd] as const;
  const scroll = bodyInput.scrollTop;
  panel.querySelectorAll<HTMLButtonElement>('button').forEach(button => button.disabled = true);
