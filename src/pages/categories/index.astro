---
import { getCollection } from 'astro:content';
import { CATEGORY_DESCRIPTIONS, CATEGORY_TREE, type Category } from '../../lib/categories';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const categoryCounts = new Map<Category, number>();
const subcategoryCounts = new Map<string, number>();

posts.forEach((post) => {
  if (post.data.category) {
    categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) || 0) + 1);
  }

  if (post.data.category && post.data.subcategory) {
    const key = `${post.data.category}\u0000${post.data.subcategory}`;
    subcategoryCounts.set(key, (subcategoryCounts.get(key) || 0) + 1);
  }
});

const categories = Array.from(categoryCounts.entries()).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="文章分类 - 书山有路">
  <h1 class="text-2xl lg:text-3xl font-bold mb-8">分类</h1>

  {categories.length === 0 ? (
    <p class="text-gray-500">暂无分类</p>
  ) : (
    <div class="space-y-6">
      {categories.map(([category, count]) => (
        <section class="rounded-xl border border-gray-200 dark:border-gray-700 p-6">
          <div class="flex items-start justify-between gap-4 mb-4">
            <div>
              <h2 class="text-xl font-semibold">
                <a href={`/categories/${category}/`} class="hover:text-blue-600 dark:hover:text-blue-400">
                  {category}
                </a>
              </h2>
              <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">{CATEGORY_DESCRIPTIONS[category]}</p>
            </div>
            <span class="shrink-0 text-sm text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-800 px-3 py-1 rounded-full">
              {count} 篇
            </span>
          </div>
          <div class="flex flex-wrap gap-2">
            {CATEGORY_TREE[category].map((subcategory) => {
              const subcategoryCount = subcategoryCounts.get(`${category}\u0000${subcategory}`) || 0;
              return subcategoryCount > 0 && (
                <a
                  href={`/categories/${category}/${subcategory}/`}
                  class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-gray-100 dark:bg-gray-800 text-sm hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  {subcategory} <span class="rounded-full bg-white dark:bg-gray-700 px-2 text-xs text-gray-600 dark:text-gray-300" aria-label={`${subcategoryCount} 篇文章`}>{subcategoryCount}</span>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  )}
</BaseLayout>
