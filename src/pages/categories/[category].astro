---
import { getCollection } from 'astro:content';
import { CATEGORY_TREE, type Category } from '../../lib/categories';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const categories = new Set<string>();

  posts.forEach((post) => {
    if (post.data.category) categories.add(post.data.category);
  });

  return Array.from(categories).map((category) => ({
    params: { category },
    props: { category }
  }));
}

interface Props {
  category: string;
}

const { category } = Astro.props;
const posts = await getCollection('posts', ({ data }) =>
  !data.draft && data.category === category
);
const subcategoryCounts = new Map<string, number>();

posts.forEach((post) => {
  if (post.data.subcategory) {
    subcategoryCounts.set(post.data.subcategory, (subcategoryCounts.get(post.data.subcategory) || 0) + 1);
  }
});

const subcategories = CATEGORY_TREE[category as Category] || [];
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={`${category} - 书山有路`}>
  <div class="mb-8">
    <a href="/categories/" class="text-blue-600 hover:underline">&larr; 返回分类列表</a>
  </div>

  <header class="mb-8">
    <h1 class="text-2xl lg:text-3xl font-bold mb-2">{category}</h1>
    <p class="text-gray-500 dark:text-gray-400">共 {posts.length} 篇文章</p>
  </header>

  {subcategories.length > 0 && (
    <nav class="flex flex-wrap gap-2 mb-8" aria-label={`${category} 的二级分类`}>
      {subcategories.map((subcategory) => {
        const count = subcategoryCounts.get(subcategory) || 0;
        return count > 0 && (
          <a
            href={`/categories/${category}/${subcategory}/`}
            class="px-3 py-1.5 rounded-lg bg-gray-100 dark:bg-gray-800 text-sm hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
          >
            {subcategory} <span class="text-gray-500">{count}</span>
          </a>
        );
      })}
    </nav>
  )}

  {posts.length === 0 ? (
    <p class="text-gray-500">该分类下没有文章</p>
  ) : (
    <ul class="space-y-6">
      {posts.map((post) => (
        <li class="border-b border-gray-200 dark:border-gray-800 pb-6">
          <article>
            <time class="text-sm text-gray-500">
              {post.data.date.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
            <h2 class="text-xl font-semibold mt-2">
              <a href={`/posts/${post.id}/`} class="hover:text-blue-600 dark:hover:text-blue-400">
                {post.data.title}
              </a>
            </h2>
            {post.data.description && (
              <p class="text-gray-600 dark:text-gray-400 mt-2 text-sm">
                {post.data.description}
              </p>
            )}
            {post.data.tags && (
              <div class="flex gap-2 mt-3 flex-wrap">
                {post.data.tags.map((tag) => (
                  <a
                    href={`/tags/${tag}/`}
                    class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded text-sm hover:bg-gray-200 dark:hover:bg-gray-700"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            )}
          </article>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
