---
import { randomUUID } from 'node:crypto';

interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const toc = headings.filter(h => h.depth >= 2 && h.depth <= 4);
const listId = `toc-list-${randomUUID()}`;
---

{toc.length > 0 && (
  <nav class="toc">
    <button type="button" class="toc-toggle" aria-label="展开/收起目录" aria-expanded="true" aria-controls={listId}>
      <span class="toc-toggle-title">目录</span>
      <span class="toc-toggle-icon">▾</span>
    </button>
    <ul id={listId} class="space-y-2 toc-list">
      {toc.map((heading) => (
        <li class={`toc-item toc-depth-${heading.depth}`}>
          <a
            href={`#${heading.slug}`}
            class="block text-sm text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    background: #f9fafb;
    border-radius: 8px;
    padding: 1rem;
  }

  :global(.dark) .toc {
    background: #1f2937;
  }

  .toc-toggle {
    display: none;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    margin-bottom: 0.75rem;
  }

  .toc-toggle-title {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #374151;
  }

  :global(.dark) .toc-toggle-title {
    color: #d1d5db;
  }

  .toc-toggle-icon {
    font-size: 0.875rem;
    color: #6b7280;
    transition: transform 0.2s ease;
  }

  .toc.collapsed .toc-toggle-icon {
    transform: rotate(-90deg);
  }

  /* 与 Tailwind lg 一致：1024px 起始终显示，不依赖窄屏遗留的折叠类。 */
  @media (min-width: 1024px) {
    .toc.collapsed .toc-list {
      display: block;
    }
  }

  @media (width < 1024px) {
    .toc.collapsed .toc-list {
      display: none;
    }

    .toc-toggle {
      display: flex;
    }

    .toc {
      padding: 0.75rem;
    }

    .toc-list {
      max-height: none !important;
    }
  }

  .toc-depth-2 {
    padding-left: 0;
  }
  .toc-depth-3 {
    padding-left: 0.75rem;
  }
  .toc-depth-4 {
    padding-left: 1.5rem;
  }
  .toc-list {
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }
  .toc-list::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const desktop = window.matchMedia('(min-width: 1024px)');
  document.querySelectorAll<HTMLElement>('.toc').forEach(toc => {
    const toggle = toc.querySelector<HTMLButtonElement>('.toc-toggle');
    if (!toggle) return;
    // 单独保留窄屏偏好；宽屏强制展开，跨断点时同步 ARIA 和实际可见性。
    let mobileExpanded = false;
    const syncExpanded = () => {
      const expanded = desktop.matches || mobileExpanded;
      toc.classList.toggle('collapsed', !expanded);
      toggle.setAttribute('aria-expanded', String(expanded));
    };
    syncExpanded();
    desktop.addEventListener('change', syncExpanded);
    toggle.addEventListener('click', () => {
      if (!desktop.matches) mobileExpanded = !mobileExpanded;
      syncExpanded();
    });
  });
</script>