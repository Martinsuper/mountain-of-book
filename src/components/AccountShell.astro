---
interface Props { title: string }
const { title } = Astro.props;
---
<section class="account-shell">
  <div class="account-heading"><h1>{title}</h1><slot name="actions" /></div>
  <p id="account-status" role="status" aria-live="polite">正在检查登录状态…</p>
  <noscript>账号功能需要启用 JavaScript；未登录时不会提供受限正文。</noscript>
  <slot />
</section>
<style is:global>
.account-shell { max-width: 760px; margin: 0 auto; }
.account-shell .account-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:1.5rem; }
.account-shell .account-heading h1 { font-size:1.8rem; font-weight:700; margin:0; }
@media(max-width:520px) { .account-shell .account-heading h1 { font-size:1.5rem; } }
.account-shell h2 { font-size: 1.2rem; font-weight: 600; margin: 1.5rem 0 .75rem; }
.account-shell a { color:#2563eb; }
.dark .account-shell a { color:#93c5fd; }
.account-shell form { display:grid; gap:.8rem; margin:1rem 0; }
.account-shell label { display:grid; gap:.35rem; }
.account-shell input, .account-shell textarea, .account-shell select { width:100%; padding:.65rem; border:1px solid #9ca3af; border-radius:.5rem; background:transparent; color:inherit; }
.account-shell option { color:#111827; background:white; }
.account-shell button, .account-shell .button { padding:.5rem .85rem; border:1px solid #9ca3af; border-radius:.5rem; width:fit-content; cursor:pointer; }
.account-shell button:disabled { opacity:.5; cursor:wait; }
.account-shell ul { display:grid; gap:.75rem; padding:0; list-style:none; }
.account-shell li { padding:.8rem; border:1px solid #9ca3af; border-radius:.5rem; overflow-wrap:anywhere; }
.account-shell li button { margin-left:.6rem; }
.account-shell [hidden] { display:none!important; }
.account-shell #account-status { margin:1rem 0; white-space:pre-wrap; }
.account-shell .hint { color:#6b7280; font-size:.9rem; }
.dark .account-shell .hint { color:#9ca3af; }
</style>
