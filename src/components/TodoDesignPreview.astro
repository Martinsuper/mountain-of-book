100%;width:40%}.todo-preview .archive{margin-top:20px;color:var(--muted);font-size:12px;border-top:1px solid var(--line);padding-top:17px}.todo-preview .archive summary{cursor:pointer}.todo-preview .archive .task{background:var(--surface)}.todo-preview .archive .task-title{text-decoration:line-through}.todo-preview .footer{display:flex;justify-content:space-between;margin-top:28px;color:var(--muted);font-size:11px;gap:15px}.todo-preview .note{background:var(--tint);color:var(--accent);border-radius:8px;padding:12px 16px;font-size:12px;margin-top:22px}.todo-preview .menu-wrap{position:relative}.todo-preview .menu{position:absolute;top:46px;right:0;z-index:5;width:160px;padding:5px;background:var(--surface);border:1px solid var(--line);border-radius:9px;box-shadow:0 8px 24px #0001}.todo-preview .menu button{display:block;width:100%;border:0;text-align:left;font-size:12px}.todo-preview .hidden{display:none!important}.todo-preview .filters{display:flex;gap:6px;flex-wrap:wrap}.todo-preview .filters button{border-color:transparent;background:transparent;font-size:12px;padding:6px 11px}.todo-preview .filters .active{background:var(--tint);color:var(--accent)}.todo-preview .list-panel .group-title{padding:15px 20px;font-size:11px;color:var(--muted);background:var(--soft);letter-spacing:1px}.todo-preview .list-panel .task{padding:19px 22px;align-items:center}.todo-preview .list-panel .meta{margin-top:4px}.todo-preview .list-panel .task .right-tag{font-size:10px;color:var(--q);flex-shrink:0}.todo-preview .list-panel .task-title{font-size:14px}.todo-preview .list-panel .add-inline{padding:16px 22px}.todo-preview .daily-head{border-left:3px solid var(--accent);padding-left:15px;margin:4px 0 24px}.todo-preview .daily-head h2{font-size:21px;margin:0}.todo-preview .daily-head p{font-size:12px;color:var(--muted);margin:5px 0}.todo-preview .schedule-layout{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:20px}.todo-preview .big-calendar{background:var(--surface);border:1px