<script is:inline>
(()=>{

const root=document.querySelector(".todo-preview");
const $=s=>root.querySelector(s);
const qs=[null,{name:'重要且紧急',short:'立即处理',color:'var(--red)'},{name:'重要不紧急',short:'计划安排',color:'var(--accent)'},{name:'紧急不重要',short:'委托简化',color:'var(--amber)'},{name:'不紧急不重要',short:'暂缓处理',color:'var(--gray)'}];
const initial=[{id:1,title:'修复移动端文章目录遮挡',q:1,date:'2026-05-18',time:'10:00',tag:'博客维护'},{id:2,title:'完成 AI 工程实践文章初稿',q:1,date:'2026-05-18',time:'16:00',tag:'内容创作'},{id:3,title:'梳理个人知识库分类结构',q:2,date:'2026-05-20',time:'',tag:'知识整理'},{id:4,title:'阅读 Astro 内容集合文档',q:2,date:'2026-05-22',time:'',tag:'学习计划'},{id:5,title:'整理本周阅读笔记',q:2,date:'',time:'',tag:'个人成长'},{id:6,title:'回复文章评论与反馈',q:3,date:'2026-05-19',time:'11:00',tag:'日常事务'},{id:7,title:'整理浏览器收藏夹',q:4,date:'',time:'',tag:'稍后再做'},{id:8,title:'更新博客依赖版本',q:2,date:'2026-05-17',time:'',tag:'博客维护',done:true},{id:9,title:'发布 PlantUML 使用笔记',q:2,date:'2026-05-16',time:'',tag:'内容创作',done:true}];
let tasks=structuredClone(initial),mode='a',filter=0,selected=18,month=4,year=2026;
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const dateKey=d=>`${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
const matches=t=>t.title.toLowerCase().includes($('#search').value.trim().toLowerCase());
function row(t,list=false){return `<div class="task" style="--q:${qs[t.q].color}"><input type="checkbox" data-id="${t.id}" aria-label="${esc(t.title)}：标记完成" ${t.done?'checked':''}><div class="body"><div class="task-title">${esc(t.title)}</div><div class="meta"><span class="${t.date==='2026-05-18'?'due':''}">${t.date?(t.date==='2026-05-18'?'今天':`${Number(t.date.slice(5,7))} 月 ${Number(t.date.slice(8))} 日`)+(t.time?' · '+t.time:''):'未安排日期'}</span><span class="tag">${esc(t.tag)}</span></div></div>${list?`<span class="right-tag">${qs[t.q].name}</span>`:''}</div>`}
function calendar(large=false){const start=(new Date(year,month,1).getDay()+6)%7,days=new Date(year,month+1,0).getDate(),prev=new Date(year,month,0).getDate(),n=Math.ceil((start+days)/7)*7;let cells='';for(let i=0;i<n;i++){let d=i-start+1,valid=d>0&&d<=days,label=d<1?prev+d:d>days?d-days:d;let hits=valid?tasks.filter(t=>!t.done&&t.date===dateKey(d)):[];cells+=large?`<div class="cell ${valid&&selected===d?'selected':''}" ${valid?`data-day="${d}" role="button" tabindex="0" aria-label="选择 ${d} 日"`:''}><span class="day" style="${valid?'':'opacity:.4'}">${label}</span>${hits.slice(0,2).map(t=>`<div class="event" style="--q:${qs[t.q].color}">${esc(t.title)}</div>`).join('')}${hits.length>2?`<div class="meta">另 ${hits.length-2} 项</div>`:''}</div>`:`<button class="${valid?'':'faded'} ${valid&&selected===d?'selected':''} ${hits.length?'has-task':''}" ${valid?`data-day="${d}"`:'disabled'} aria-label="${month+1} 月 ${label} 日">${label}</button>`}return `${large?`<div class="big-top"><h2>${year} 年 ${month+1} 月</h2><div><button data-month="-1" aria-label="上个月">‹</button> <button data-month="1" aria-label="下个月">›</button></div></div>`:`<div class="month"><strong>${year} 年 ${month+1} 月</strong><div><button data-month="-1" aria-label="上个月">‹</button><button data-month="1" aria-label="下个月">›</button></div></div>`}<div class="${large?'big-week':'week'}">${['一','二','三','四','五','六','日'].map(d=>`<span>${d}</span>`).join('')}</div><div class="${large?'big-grid':'mini'}">${cells}</div>`}
function miniAside(){const hits=tasks.filter(t=>!t.done&&t.date===dateKey(selected));return `<aside class="aside"><section class="panel">${calendar()}<div class="agenda"><div class="section-title" style="margin-bottom:0">${month+1} 月 ${selected} 日 · ${hits.length} 项待办</div>${hits.length?hits.map(t=>`<div class="agenda-item"><time>${t.time||'全天'}</time><span>${esc(t.title)}</span></div>`).join(''):'<p class="focus-note" style="margin-top:10px">这一天还没有安排。</p>'}</div></section><section class="panel"><h2 class="section-title">留一点时间，给长期计划</h2><p class="focus-note">重要但不紧急的事，也值得被认真安排。</p><div class="progress"><div style="width:${tasks.filter(t=>t.done).length/tasks.length*100}%"></div></div><span class="demo-label">${tasks.filter(t=>t.done).length} / ${tasks.length} 项已完成</span></section></aside>`}
function render(){const pending=tasks.filter(t=>!t.done&&matches(t));$('#summary').innerHTML=`<span><b>${tasks.filter(t=>!t.done).length}</b>待办</span><span class="divider"></span><span><b>${tasks.filter(t=>!t.done&&t.date==='2026-05-18').length}</b>今天到期</span><span class="divider"></span><span><b>${tasks.filter(t=>t.done).length}</b>已完成</span>`;$('#viewControls').innerHTML=mode==='b'?`<div class="filters">${[0,1,2,3,4].map(q=>`<button data-filter="${q}" class="${filter===q?'active':''}">${q?qs[q].short:'全部任务'}</button>`).join('')}</div>`:mode==='a'?'四象限视图 <span style="margin:0 10px;color:var(--line)">/</span> 按优先级安排':'月度日程 <span style="margin:0 10px;color:var(--line)">/</span> 点击日期查看待办';
if(mode==='a'){$('#content').innerHTML=`<div class="layout"><div class="matrix">${[1,2,3,4].map(q=>{const ts=pending.filter(t=>t.q===q);return `<section class="panel" style="--q:${qs[q].color}"><div class="qhead"><span class="dot"></span><h2>${qs[q].name}</h2><span class="count">${ts.length}</span></div><div class="qdesc">${qs[q].short}</div>${ts.map(t=>row(t)).join('')||'<div class="empty">暂时没有任务，留一些余裕。</div>'}<button class="add-inline" data-add="${q}">＋ 添加任务</button></section>`}).join('')}</div>${miniAside()}</div>`}
else if(mode==='b'){const ts=pending.filter(t=>!filter||t.q===filter);const today=ts.filter(t=>t.date==='2026-05-18'),later=ts.filter(t=>t.date!=='2026-05-18');$('#content').innerHTML=`<div class="layout"><section class="panel list-panel">${today.length?`<div class="group-title">今天 · ${today.length} 项</div>${today.map(t=>row(t,true)).join('')}`:''}${later.length?`<div class="group-title">接下来 · ${later.length} 项</div>${later.map(t=>row(t,true)).join('')}`:''}${!ts.length?'<div class="empty">没有匹配的任务。</div>':''}<button class="add-inline" data-add="2">＋ 添加一件事</button></section>${miniAside()}</div>`}
else{const ts=pending.filter(t=>t.date===dateKey(selected));$('#content').innerHTML=`<div class="schedule-layout"><section class="big-calendar">${calendar(true)}</section><aside><div class="daily-head"><h2>${month+1} 月 ${selected} 日</h2><p>${ts.length} 件待办，按轻重缓急排列。</p></div><section class="panel">${ts.sort((a,b)=>a.q-b.q).map(t=>row(t)).join('')||'<div class="empty">今天没有安排，享受一点留白。</div>'}<button class="add-inline" data-add="2">＋ 为这一天添加任务</button></section><h3 class="section-title" style="margin-top:24px;color:var(--muted)">未安排日期</h3><section class="panel">${pending.filter(t=>!t.date).map(t=>row(t)).join('')||'<div class="empty">所有任务都已安排。</div>'}</section></aside></div>`}
$('#archiveTitle').textContent=`已完成 · ${tasks.filter(t=>t.done).length} 项`;$('#archiveTasks').innerHTML=tasks.filter(t=>t.done&&matches(t)).map(t=>row(t)).join('');$('#designNote').textContent={a:'方案 A：保留四象限，使用中性卡片和小色点区分优先级；缩小日历，常用操作前置，其他操作收进菜单。',b:'方案 B：以清单为核心，四象限改为筛选；减少容器嵌套，适合任务较多、希望快速浏览和完成的场景。',c:'方案 C：以月度日历为核心，右侧展示选中日期的待办；适合截止日期明确、需要统筹日程的场景。'}[mode]}
function openTask(q=2){$('#taskQ').value=q;$('#taskDate').value=mode==='c'?dateKey(selected):'2026-05-18';$('#taskDialog').showModal();$('#taskName').focus()}
root.addEventListener('click',e=>{const m=e.target.closest('[data-mode]');if(m){mode=m.dataset.mode;root.querySelectorAll('[data-mode]').forEach(b=>b.classList.toggle('active',b===m));$('#title').textContent='待办清单';$('#subtitle').textContent='按轻重缓急管理任务。';render()}const add=e.target.closest('[data-add]');if(add)openTask(add.dataset.add);const f=e.target.closest('[data-filter]');if(f){filter=Number(f.dataset.filter);render()}const d=e.target.closest('[data-day]');if(d){selected=Number(d.dataset.day);render()}const nav=e.target.closest('[data-month]');if(nav){const next=new Date(year,month+Number(nav.dataset.month),1);year=next.getFullYear();month=next.getMonth();selected=Math.min(selected,new Date(year,month+1,0).getDate());render()}if(!e.target.closest('.menu-wrap')){$('#menu').classList.add('hidden');$('#more').setAttribute('aria-expanded','false')}});
root.addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&e.target.matches('.cell[data-day]')){e.preventDefault();selected=Number(e.target.dataset.day);render()}});
root.addEventListener('change',e=>{if(e.target.matches('[data-id]')){tasks.find(t=>t.id===Number(e.target.dataset.id)).done=e.target.checked;render()}});
$('#search').addEventListener('input',render);$('#newTask').onclick=()=>openTask();$('#cancel').onclick=()=>$('#taskDialog').close();$('#taskForm').onsubmit=e=>{e.preventDefault();const title=$('#taskName').value.trim();if(!title){$('#taskName').setCustomValidity('请输入任务名称');$('#taskName').reportValidity();return}tasks.push({id:Date.now(),title,q:Number($('#taskQ').value),date:$('#taskDate').value,time:'',tag:'新任务'});$('#taskDialog').close();$('#taskForm').reset();render()};$('#taskName').oninput=()=>$('#taskName').setCustomValidity('');$('#more').onclick=()=>{const show=$('#menu').classList.toggle('hidden');$('#more').setAttribute('aria-expanded',String(!show))};$('#reset').onclick=()=>{tasks=structuredClone(initial);$('#search').value='';render();$('#menu').classList.add('hidden');$('#more').setAttribute('aria-expanded','false')};$('#export').onclick=()=>{const url=URL.createObjectURL(new Blob([JSON.stringify(tasks,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='todo-demo.json';a.click();URL.revokeObjectURL(url);$('#menu').classList.add('hidden');$('#more').setAttribute('aria-expanded','false')};
render();

})();
</script>
