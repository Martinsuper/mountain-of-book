---
import CodeCopy from './CodeCopy.astro';
---
<p id="account-status" role="status" aria-live="polite" class="text-sm text-gray-500 mb-6">正在加载文章…</p>
<div id="private-article" hidden class="lg:grid lg:grid-cols-[minmax(0,1fr)_220px] lg:gap-12 lg:max-w-5xl">
  <article class="prose dark:prose-invert max-w-none min-w-0">
    <header class="mb-8 not-prose">
      <h1 id="private-title" class="text-2xl lg:text-4xl font-bold mb-4"></h1>
      <div class="flex items-center gap-4 text-gray-500 dark:text-gray-400 flex-wrap"><time id="article-date"></time><span id="article-reading-time"></span><span id="article-visibility"></span></div>
    </header>
    <div id="private-body"></div>
    <CodeCopy />
  </article>
  <aside class="mt-8 lg:mt-0"><nav id="cloud-toc" aria-label="文章目录" class="lg:sticky lg:top-24 text-sm space-y-2"><h2 class="font-semibold mb-3">目录</h2><ul class="space-y-2 text-gray-500"></ul></nav></aside>
</div>
<noscript>云端文章需要启用 JavaScript。登录可见文章仅在登录后加载。</noscript>
<style>
  [hidden] { display:none!important; }
</style>
<script>
import '../lib/cloud-article';
</script>
