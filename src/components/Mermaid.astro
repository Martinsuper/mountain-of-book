---
// src/components/Mermaid.astro
---

<script>
  // 仅当页面真正包含 .mermaid 图表时才动态加载 mermaid（约 2MB JS），
  // 避免纯文字文章也被迫加载整个 mermaid 包。
  let mermaidMod: typeof import('mermaid').default | null = null;

  function getTheme() {
    return document.documentElement.classList.contains('dark') ? 'dark' : 'default';
  }

  async function loadMermaid() {
    if (mermaidMod) return mermaidMod;
    const mod = await import('mermaid');
    mermaidMod = mod.default;
    return mermaidMod;
  }

  // 保存每个图表的原始源码，供主题切换时重新渲染
  function cacheSources() {
    document.querySelectorAll<HTMLElement>('.mermaid').forEach((el) => {
      if (!el.getAttribute('data-mermaid-code')) {
        el.setAttribute('data-mermaid-code', el.textContent || '');
      }
    });
  }

  async function renderAll() {
    const nodes = document.querySelectorAll<HTMLElement>('.mermaid');
    if (nodes.length === 0) return;

    const mermaid = await loadMermaid();
    mermaid.initialize({
      startOnLoad: false,
      theme: getTheme(),
      securityLevel: 'strict',
      flowchart: { useMaxWidth: true, htmlLabels: true, curve: 'basis' }
    });

    // 每轮渲染用唯一前缀，避免主题切换重渲染时 SVG id 冲突
    const runId = `${Date.now()}`;
    for (let i = 0; i < nodes.length; i++) {
      const el = nodes[i];
      const code = el.getAttribute('data-mermaid-code') || el.textContent || '';
      try {
        const { svg } = await mermaid.render(`mermaid-svg-${runId}-${i}`, code);
        el.innerHTML = svg;
      } catch (err) {
        console.error('Mermaid 渲染失败:', err);
      }
    }

    // 通知 modal 组件图表已就绪，可绑定点击放大
    document.dispatchEvent(new CustomEvent('mermaid-rendered'));
  }

  document.addEventListener('DOMContentLoaded', () => {
    if (document.querySelectorAll('.mermaid').length === 0) return;

    cacheSources();
    renderAll();

    // 主题切换时重新渲染（保持与首次一致的 securityLevel）
    const observer = new MutationObserver((mutations) => {
      for (const m of mutations) {
        if (m.attributeName === 'class') {
          renderAll();
          break;
        }
      }
    });
    observer.observe(document.documentElement, { attributes: true });
  });
</script>
