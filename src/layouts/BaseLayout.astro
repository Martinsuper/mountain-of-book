---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import Search from '../components/Search.astro';
import UserMenu from '../components/UserMenu.astro';
import BackToTop from '../components/BackToTop.astro';
import Mermaid from '../components/Mermaid.astro';
import ZoomModal from '../components/ZoomModal.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  fullWidth?: boolean;
  /** 比默认 max-w-4xl 更宽的版心（max-w-5xl），供带侧边目录的文章页使用 */
  wide?: boolean;
  hideHeader?: boolean;
}

const {
  title = '书山有路',
  description = '书山有路勤为径，学海无涯苦作舟',
  keywords = '博客,技术,编程,学习',
  image = '/og-image.png',
  type = 'website',
  publishedTime,
  fullWidth = false,
  wide = false,
  hideHeader = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === '书山有路' ? title : `${title} | 书山有路`;
const currentPath = Astro.url.pathname;

// 导航分组：当前路径命中组内任一路由时，高亮该组按钮
const isPostsSection =
  ['/archive/', '/timeline/'].includes(currentPath) ||
  currentPath.startsWith('/categories') ||
  currentPath.startsWith('/tags') || currentPath.startsWith('/posts/');

---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="书山有路" />
    {(currentPath.startsWith('/account') || currentPath.startsWith('/members')) && <meta name="robots" content="noindex, nofollow" />}
    {currentPath.startsWith('/members') && <meta name="referrer" content="no-referrer" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="书山有路" />
    <meta property="og:locale" content="zh_CN" />

    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="书山有路 RSS" href="/rss.xml" />

    <!-- Preconnect for external domains -->
    <link rel="preconnect" href="https://www.plantuml.com" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(
      type === 'article' ? {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": title,
        "datePublished": publishedTime,
        "description": description,
        "image": new URL(image, Astro.site).href,
        "url": canonicalURL.href,
        "author": { "@type": "Person", "name": "书山有路" },
        "publisher": {
          "@type": "Organization",
          "name": "书山有路",
          "logo": { "@type": "ImageObject", "url": new URL('/og-image.png', Astro.site).href }
        }
      } : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "书山有路",
        "url": new URL('/', Astro.site).href,
        "description": description
      }
    ).replace(/</g, '\\u003c')} />

    <title>{fullTitle}</title>
    {hideHeader ? (
      <script is:inline>
        (function() {
          var t = localStorage.getItem('dev-theme') || 'dark';
          if (t !== 'light') document.documentElement.classList.add('dark');
        })();
      </script>
    ) : (
      <script is:inline>
        let savedTheme = localStorage.getItem('theme');
        if (savedTheme && savedTheme !== 'light' && savedTheme !== 'dark') {
          localStorage.removeItem('theme');
          savedTheme = null;
        }
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (savedTheme === 'dark' || (!savedTheme && systemDark)) {
          document.documentElement.classList.add('dark');
        }
      </script>
    )}
  </head>
  <body class="min-h-screen bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100">
    {!hideHeader && <header class="sticky top-0 z-50 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800">
      <nav class="max-w-4xl mx-auto px-4 py-3 flex items-center gap-3 min-w-0">
          <a href="/" class="text-lg font-bold hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-200 no-underline truncate shrink-0">
            书山有路
          </a>
          <!-- 移动端：汉堡菜单按钮 -->
          <button id="mobile-menu-btn" class="lg:hidden ml-auto p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="菜单" aria-expanded="false" aria-controls="mobile-menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <!-- 桌面端：同级页面导航 -->
          <div id="desktop-navigation" class="hidden lg:flex items-center gap-2 shrink-0 ml-auto">
          <a
            href="/"
            class={`px-4 py-2 rounded-full transition-all duration-200 no-underline ${currentPath === '/' ? 'bg-blue-600 dark:bg-blue-500 text-white font-medium' : 'bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700'}`}
          >
            首页
          </a>

          <!-- 文章分组 -->
          <div class="nav-group">
            <button
              class={`nav-group-btn px-4 py-2 rounded-full transition-all duration-200 ${isPostsSection ? 'bg-blue-600 dark:bg-blue-500 text-white font-medium' : 'bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700'}`}
              aria-expanded="false" aria-controls="posts-menu"
            >
              文章
              <svg class="nav-caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div id="posts-menu" class="nav-dropdown" inert>
              <a href="/archive/" class={`nav-dropdown-link ${currentPath === '/archive/' ? 'active' : ''}`}>归档</a>
              <a href="/timeline/" class={`nav-dropdown-link ${currentPath === '/timeline/' ? 'active' : ''}`}>时间轴</a>
              <a href="/categories/" class={`nav-dropdown-link ${currentPath.startsWith('/categories') ? 'active' : ''}`}>分类</a>
              <a href="/tags/" class={`nav-dropdown-link ${currentPath.startsWith('/tags') ? 'active' : ''}`}>标签</a>
            </div>
          </div>

          <a href="/todo/" aria-current={currentPath === '/todo/' ? 'page' : undefined} class={`px-4 py-2 rounded-full transition-all duration-200 no-underline ${currentPath === '/todo/' ? 'bg-blue-600 dark:bg-blue-500 text-white font-medium' : 'bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700'}`}>待办</a>
        </div>
        <div id="header-tools" class="flex items-center gap-2 shrink-0 lg:pl-3 lg:border-l lg:border-gray-200 lg:dark:border-gray-800">
          <Search />
          <ThemeToggle />
          <UserMenu />
        </div>
      </nav>
      <!-- 移动端：下拉导航菜单 -->
      <div id="mobile-menu" class="mobile-menu lg:hidden" aria-hidden="true" inert>
        <a href="/" aria-current={currentPath === '/' ? 'page' : undefined} class={`mobile-nav-link ${currentPath === '/' ? 'active' : ''}`}>首页</a>
        <div class="mobile-nav-group-label">文章</div>
        <a href="/archive/" aria-current={currentPath === '/archive/' ? 'page' : undefined} class={`mobile-nav-link ${currentPath === '/archive/' ? 'active' : ''}`}>归档</a>
        <a href="/timeline/" aria-current={currentPath === '/timeline/' ? 'page' : undefined} class={`mobile-nav-link ${currentPath === '/timeline/' ? 'active' : ''}`}>时间轴</a>
        <a href="/categories/" aria-current={currentPath.startsWith('/categories') ? 'page' : undefined} class={`mobile-nav-link ${currentPath.startsWith('/categories') ? 'active' : ''}`}>分类</a>
        <a href="/tags/" aria-current={currentPath.startsWith('/tags') ? 'page' : undefined} class={`mobile-nav-link ${currentPath.startsWith('/tags') ? 'active' : ''}`}>标签</a>
        <a href="/todo/" aria-current={currentPath === '/todo/' ? 'page' : undefined} class={`mobile-nav-link ${currentPath === '/todo/' ? 'active' : ''}`}>待办</a>
        <div class="mobile-nav-group-label">个人</div>
        <a data-user-guest href="/account/" class="mobile-nav-link">登录</a>
        <a data-user-auth hidden href="/account/" aria-current={currentPath === '/account/' ? 'page' : undefined} class={`mobile-nav-link ${currentPath === '/account/' ? 'active' : ''}`}>个人中心</a>
        <a data-user-admin hidden href="/account/admin/" aria-current={currentPath === '/account/admin/' ? 'page' : undefined} class={`mobile-nav-link ${currentPath === '/account/admin/' ? 'active' : ''}`}>文章管理</a>
        <button data-user-auth data-user-signout hidden type="button" class="mobile-nav-link text-left">退出登录</button>
        <p data-user-status role="status" hidden class="px-4 py-2 text-sm text-red-600 dark:text-red-400"></p>
      </div>
    </header>}
    <main class={fullWidth ? '' : wide ? 'max-w-5xl mx-auto px-4 py-8' : 'max-w-4xl mx-auto px-4 py-8'}>
      <slot />
    </main>
    <Mermaid />
    <ZoomModal />
    <BackToTop />
  </body>
</html>

<style>
  :global(header [hidden]) { display: none !important; }

  /* Nav group dropdown (desktop) */
  .nav-group {
    position: relative;
    display: inline-flex;
  }


  .nav-group-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: none;
    cursor: pointer;
    font-size: inherit;
  }

  .nav-caret {
    transition: transform 0.2s ease;
  }

  .nav-group.open .nav-caret {
    transform: rotate(180deg);
  }

  .nav-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.5rem;
    min-width: 9rem;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    padding: 0.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 60;
  }

  :global(.dark) .nav-dropdown {
    background: #1f2937;
    border-color: #374151;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  /* 用伪元素填补按钮与面板的间隙，避免 hover 移动时下拉收起 */
  .nav-dropdown::before {
    content: '';
    position: absolute;
    top: -0.5rem;
    left: 0;
    right: 0;
    height: 0.5rem;
  }

  .nav-group.open .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-dropdown-link {
    display: block;
    padding: 0.5rem 0.875rem;
    border-radius: 0.5rem;
    color: #4b5563;
    text-decoration: none;
    font-size: 0.9rem;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }

  :global(.dark) .nav-dropdown-link {
    color: #d1d5db;
  }

  .nav-dropdown-link:hover {
    background: #f3f4f6;
    color: #3b82f6;
  }

  :global(.dark) .nav-dropdown-link:hover {
    background: #374151;
    color: #60a5fa;
  }

  .nav-dropdown-link.active {
    background: #eff6ff;
    color: #3b82f6;
    font-weight: 600;
  }

  :global(.dark) .nav-dropdown-link.active {
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
  }

  /* Mobile nav group label */
  .mobile-nav-group-label {
    padding: 0.5rem 1rem 0.25rem;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #9ca3af;
  }

  :global(.dark) .mobile-nav-group-label {
    color: #6b7280;
  }

  /* Mobile menu */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: #fff;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    border-top: 1px solid transparent;
  }

  @media (min-width: 1024px) { .mobile-menu { display: none; } }

  .mobile-menu.open {
    max-height: calc(100dvh - 70px);
    overflow-y: auto;
    box-shadow: 0 12px 24px rgb(0 0 0 / 10%);
    border-top-color: #e5e7eb;
  }

  :global(.dark) .mobile-menu.open {
    border-top-color: #374151;
    background: #111827;
  }
  .mobile-nav-group-label { grid-column: 1 / -1; }
  .mobile-nav-link:first-child { grid-column: 1 / -1; }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 1rem;
    color: #4b5563;
    text-decoration: none;
    font-size: 1rem;
    border-bottom: 1px solid #f3f4f6;
    transition: background 0.15s;
  }

  :global(.dark) .mobile-nav-link {
    color: #d1d5db;
    border-bottom-color: #1f2937;
  }

  .mobile-nav-link:hover {
    background: #f9fafb;
  }

  :global(.dark) .mobile-nav-link:hover {
    background: #1f2937;
  }

  .mobile-nav-link.active {
    color: #3b82f6;
    font-weight: 600;
    background: #eff6ff;
  }

  :global(.dark) .mobile-nav-link.active {
    color: #60a5fa;
    background: rgba(59, 130, 246, 0.1);
  }

</style>

<script>
const groups = [...document.querySelectorAll<HTMLElement>('header .nav-group')];
function setDropdown(group: HTMLElement, open: boolean) {
  group.classList.toggle('open', open);
  group.querySelector('button')?.setAttribute('aria-expanded', String(open));
  const menu = group.querySelector<HTMLElement>('.nav-dropdown');
  if (menu) menu.inert = !open;
}
function closeDropdowns(except?: HTMLElement) {
  groups.forEach(group => { if (group !== except) setDropdown(group, false); });
}
groups.forEach(group => {
  const button = group.querySelector('button')!;
  button.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') !== 'true';
    closeDropdowns(); setDropdown(group, open);
  });
  group.addEventListener('keydown', event => {
    if (event.key === 'Escape') { setDropdown(group, false); button.focus(); event.preventDefault(); return; }
    if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault(); closeDropdowns(group); setDropdown(group, true);
    const links = [...group.querySelectorAll<HTMLElement>('.nav-dropdown a:not([hidden]), .nav-dropdown button:not([hidden])')];
    const index = links.indexOf(document.activeElement as HTMLElement);
    const next = event.key === 'Home' ? 0 : event.key === 'End' ? links.length - 1 : event.key === 'ArrowDown' ? (index + 1) % links.length : (index < 0 ? links.length - 1 : (index - 1 + links.length) % links.length);
    links[next]?.focus();
  });
});
document.addEventListener('click', event => {
  if (event.target instanceof Node) closeDropdowns(groups.find(group => group.contains(event.target as Node)));
});
document.addEventListener('focusin', event => {
  if (event.target instanceof Node) closeDropdowns(groups.find(group => group.contains(event.target as Node)));
});
// 收起的菜单不应保留可聚焦链接。
const mobileMenuBtn = document.getElementById('mobile-menu-btn');
const mobileMenu = document.getElementById('mobile-menu');
function setMobileMenu(open: boolean) {
  if (!mobileMenu) return;
  mobileMenu.classList.toggle('open', open);
  mobileMenu.inert = !open;
  mobileMenu.setAttribute('aria-hidden', String(!open));
  mobileMenuBtn?.setAttribute('aria-expanded', String(open));
}
mobileMenuBtn?.addEventListener('click', () => setMobileMenu(!mobileMenu?.classList.contains('open')));
document.addEventListener('click', event => {
  if (event.target instanceof Node && !mobileMenu?.contains(event.target) && !mobileMenuBtn?.contains(event.target)) setMobileMenu(false);
});
document.addEventListener('focusin', event => {
  if (event.target instanceof Node && !mobileMenu?.contains(event.target) && !mobileMenuBtn?.contains(event.target)) setMobileMenu(false);
});
mobileMenu?.querySelectorAll('.mobile-nav-link').forEach(link => {
  link.addEventListener('click', () => setMobileMenu(false));
});
document.addEventListener('keydown', event => {
  if (event.key === 'Escape' && mobileMenu?.classList.contains('open')) {
    setMobileMenu(false);
    mobileMenuBtn?.focus();
  }
});
window.matchMedia('(min-width: 1024px)').addEventListener('change', () => { setMobileMenu(false); closeDropdowns(); });
</script>
